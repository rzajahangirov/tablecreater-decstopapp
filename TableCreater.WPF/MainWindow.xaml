<Window x:Class="TableCreater.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:pages="clr-namespace:TableCreater.WPF.Views.Pages"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="TableCreater Accounting v1.0"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#F5F5F5"
                BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="20,24,20,8">
                    <TextBlock Text="TableCreater" FontSize="22" FontWeight="Bold" Foreground="#005FB8"/>
                    <TextBlock Text="Mühasibatlıq Sistemi" FontSize="12" Foreground="#666" Margin="0,2,0,0"/>
                </StackPanel>

                <Separator Grid.Row="1" Margin="16,8" Background="#E0E0E0"/>

                <!-- Nav Items -->
                <StackPanel Grid.Row="2" Margin="8,0">
                    <Button x:Name="BtnNavCustomers" Click="BtnNavCustomers_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="16,12" Margin="0,2" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#005FB8"/>
                            <TextBlock Text="Müştərilər" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnNavNewTransaction" Click="BtnNavNewTransaction_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="16,12" Margin="0,2" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#005FB8"/>
                            <TextBlock Text="Yeni Tranzaksiya" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnNavReports" Click="BtnNavReports_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="16,12" Margin="0,2" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#005FB8"/>
                            <TextBlock Text="Hesabatlar" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnNavSettings" Click="BtnNavSettings_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="16,12" Margin="0,2" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#005FB8"/>
                            <TextBlock Text="Parametrlər" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- User Info -->
                <Border Grid.Row="3" Margin="12,0,12,16" Padding="12"
                        CornerRadius="8" Background="#EAEAEA">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtUserName" Text="Admin" FontSize="13" FontWeight="SemiBold" Foreground="#333"/>
                            <TextBlock x:Name="TxtUserEmail" Text="admin@tablecreater.com" FontSize="11" Foreground="#888"/>
                        </StackPanel>
                        <Button Grid.Column="1" ToolTip="Çıxış" Click="BtnLogout_Click"
                                Padding="8" Background="Transparent" BorderThickness="0">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#666"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- CONTENT AREA -->
        <Grid Grid.Column="1" Background="#FFFFFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page Header -->
            <Border Grid.Row="0" Padding="24,16" Background="#FAFAFA"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <TextBlock x:Name="TxtPageTitle" Text="Müştərilər"
                           FontSize="24" FontWeight="SemiBold" Foreground="#222"/>
            </Border>

            <!-- Page Content -->
            <ContentControl Grid.Row="1" x:Name="PageContent"/>
        </Grid>
    </Grid>
</Window>
