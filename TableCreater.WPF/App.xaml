<Application x:Class="TableCreater.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:converters="clr-namespace:TableCreater.WPF.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ModernWpf Theme Resources — Windows 11 style -->
                <ui:ThemeResources RequestedTheme="Light" />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Value Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
            <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisConverter"/>
            <converters:EnumToUpperConverter x:Key="EnumToUpperConverter"/>
            <converters:CurrencyToSymbolConverter x:Key="CurrencyToSymbolConverter"/>
            <converters:ProfitLossToColorConverter x:Key="ProfitLossToColorConverter"/>
            <converters:ShipmentStatusToBackgroundConverter x:Key="ShipmentStatusToBgConverter"/>
            <converters:ShipmentStatusToForegroundConverter x:Key="ShipmentStatusToFgConverter"/>
            <converters:ShipmentStatusToTextConverter x:Key="ShipmentStatusToTextConverter"/>
            <converters:ShipmentStatusToGlyphConverter x:Key="ShipmentStatusToGlyphConverter"/>
            <converters:EnumEqualsToVisibilityConverter x:Key="EnumEqualsToVisConverter"/>
            <converters:EnumEqualsToBoolConverter x:Key="EnumEqualsToBoolConverter"/>
            <converters:PaymentStatusToTextConverter x:Key="PaymentStatusToTextConverter"/>
            <converters:PaymentStatusToBackgroundConverter x:Key="PaymentStatusToBgConverter"/>
            <converters:PaymentStatusToForegroundConverter x:Key="PaymentStatusToFgConverter"/>
            <converters:BalanceTypeToTextConverter x:Key="BalanceTypeToTextConverter"/>
            <converters:BalanceTypeToColorConverter x:Key="BalanceTypeToColorConverter"/>

            <!-- Status Card RadioButton Style (Unified for Dialog and Entry Page) -->
            <Style x:Key="StatusCardRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#333333"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd"
                                    Background="White"
                                    BorderBrush="#DDDDDD"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"/>
                                    <Border x:Name="Indicator" Grid.Column="1"
                                            Width="18" Height="18" CornerRadius="9"
                                            BorderBrush="#CCCCCC" BorderThickness="1.5"
                                            Background="Transparent" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#005FB8" Visibility="Collapsed"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#005FB8"/>
                                    <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#005FB8"/>
                                    <Setter TargetName="Bd" Property="Background" Value="#F0F7FF"/>
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Indicator" Property="BorderBrush" Value="#005FB8"/>
                                    <Setter Property="Foreground" Value="#005FB8"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Remove focus rectangles globally + modern selection styles -->
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>
            <Style TargetType="DataGridRow">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#E3F2FD"/>
                        <Setter Property="Foreground" Value="#000000"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#E3F2FD"/>
                        <Setter Property="Foreground" Value="#000000"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
