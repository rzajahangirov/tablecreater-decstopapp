<Application x:Class="TableCreater.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:converters="clr-namespace:TableCreater.WPF.Converters"
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ModernWpf Theme Resources — Windows 11 style -->
                <ui:ThemeResources RequestedTheme="Light" />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Value Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
            <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisConverter"/>
            <converters:EnumToUpperConverter x:Key="EnumToUpperConverter"/>
            <converters:CurrencyToSymbolConverter x:Key="CurrencyToSymbolConverter"/>
            <converters:ProfitLossToColorConverter x:Key="ProfitLossToColorConverter"/>
            <converters:ShipmentStatusToBackgroundConverter x:Key="ShipmentStatusToBgConverter"/>
            <converters:ShipmentStatusToForegroundConverter x:Key="ShipmentStatusToFgConverter"/>
            <converters:ShipmentStatusToTextConverter x:Key="ShipmentStatusToTextConverter"/>
            <converters:ShipmentStatusToGlyphConverter x:Key="ShipmentStatusToGlyphConverter"/>
            <converters:EnumEqualsToVisibilityConverter x:Key="EnumEqualsToVisConverter"/>
            <converters:EnumEqualsToBoolConverter x:Key="EnumEqualsToBoolConverter"/>
            <converters:PaymentStatusToTextConverter x:Key="PaymentStatusToTextConverter"/>
            <converters:PaymentStatusToBackgroundConverter x:Key="PaymentStatusToBgConverter"/>
            <converters:PaymentStatusToForegroundConverter x:Key="PaymentStatusToFgConverter"/>
            <converters:BalanceTypeToTextConverter x:Key="BalanceTypeToTextConverter"/>
            <converters:BalanceTypeToColorConverter x:Key="BalanceTypeToColorConverter"/>
            <converters:CustomerTypeToTextConverter x:Key="CustomerTypeToTextConverter"/>
            <converters:CustomerTypeToBackgroundConverter x:Key="CustomerTypeToBgConverter"/>
            <converters:CustomerTypeToForegroundConverter x:Key="CustomerTypeToFgConverter"/>
            <converters:IsCompletedToBackgroundConverter x:Key="IsCompletedToBgConverter"/>
            <converters:IsCompletedToForegroundConverter x:Key="IsCompletedToFgConverter"/>
            <converters:IsCompletedToTextConverter x:Key="IsCompletedToTextConverter"/>
            <converters:IsCompletedToGlyphConverter x:Key="IsCompletedToGlyphConverter"/>
            <converters:IsCompletedToRowBackgroundConverter x:Key="IsCompletedToRowBgConverter"/>

            <!-- Status Card RadioButton Style (Unified for Dialog and Entry Page) -->
            <Style x:Key="StatusCardRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#333333"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd"
                                    Background="White"
                                    BorderBrush="#DDDDDD"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"/>
                                    <Border x:Name="Indicator" Grid.Column="1"
                                            Width="18" Height="18" CornerRadius="9"
                                            BorderBrush="#CCCCCC" BorderThickness="1.5"
                                            Background="Transparent" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#005FB8" Visibility="Collapsed"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#005FB8"/>
                                    <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#005FB8"/>
                                    <Setter TargetName="Bd" Property="Background" Value="#F0F7FF"/>
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Indicator" Property="BorderBrush" Value="#005FB8"/>
                                    <Setter Property="Foreground" Value="#005FB8"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Remove focus rectangles globally + modern selection styles -->
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>
            <Style TargetType="DataGridRow">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#E3F2FD"/>
                        <Setter Property="Foreground" Value="#000000"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#E3F2FD"/>
                        <Setter Property="Foreground" Value="#000000"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>
            <!-- Modern DataGrid Selection CheckBox Style -->
            <Style x:Key="DataGridCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Bd"
                                    Width="18" Height="18"
                                    CornerRadius="4"
                                    Background="#FFFFFF"
                                    BorderBrush="#94A3B8"
                                    BorderThickness="1.5">
                                <Path x:Name="CheckGlyph"
                                      Data="M 3.5 8.5 L 7 12 L 14.5 4.5"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#107C41"/>
                                    <Setter TargetName="Bd" Property="Background" Value="#F0FDF4"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#107C41"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#107C41"/>
                                    <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="#0D6836"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#0D6836"/>
                                </MultiTrigger>
                                <Trigger Property="IsChecked" Value="{x:Null}">
                                    <Setter TargetName="Bd" Property="Background" Value="#107C41"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#107C41"/>
                                    <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="CheckGlyph" Property="Data" Value="M 4 9 L 14 9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
