<Window x:Class="TableCreater.WPF.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="TableCreater — Təhlükəsiz Giriş"
        Width="440" Height="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
        <Border Background="White" CornerRadius="12" Padding="28,32"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.06" Color="#0F172A"/>
            </Border.Effect>

            <StackPanel>
                <!-- Brand Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#EFF6FF"
                            BorderBrush="#BFDBFE" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#0284C7"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="TableCreater" FontSize="24" FontWeight="ExtraBold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Mühasibatlıq Sistemi" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Instruction -->
                <TextBlock Text="Təhlükəsizlik Kodu" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>

                <!-- Password Input Container (Integrated inside one styled box) -->
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8" Margin="0,0,0,6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="#0284C7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Hidden text input for Show Password mode -->
                        <TextBox x:Name="TxtVisiblePassword" Grid.Column="0" FontSize="15" Padding="14,10"
                                 BorderThickness="0" Background="Transparent"
                                 Visibility="Collapsed" KeyDown="Input_KeyDown"/>

                        <!-- PasswordBox for secure input -->
                        <PasswordBox x:Name="TxtPassword" Grid.Column="0" FontSize="15" Padding="14,10"
                                     BorderThickness="0" Background="Transparent"
                                     KeyDown="Input_KeyDown"/>

                        <!-- Toggle Show/Hide Password Button inside the field -->
                        <Button x:Name="BtnTogglePassword" Grid.Column="1" Click="BtnTogglePassword_Click"
                                Padding="12,0" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" ToolTip="Kodu göstər" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="IconTogglePassword" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Error Message -->
                <TextBlock x:Name="TxtError" Text="Daxil edilən kod yanlışdır!"
                           Foreground="#DC2626" FontSize="12" FontWeight="SemiBold"
                           Visibility="Collapsed" Margin="0,4,0,12"/>

                <!-- Login Button -->
                <Button x:Name="BtnLogin" Content="Daxil Ol" Click="BtnLogin_Click"
                        Margin="0,12,0,0" Padding="0,12" Background="#0284C7" Foreground="White"
                        BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand" HorizontalAlignment="Stretch">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
