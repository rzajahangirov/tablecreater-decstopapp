<Window x:Class="TableCreater.WPF.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="TableCreater — Təhlükəsiz Giriş"
        Width="440" Height="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
        <Border Background="White" CornerRadius="12" Padding="28,32"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.06" Color="#0F172A"/>
            </Border.Effect>

            <StackPanel>
                <!-- Brand Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#EFF6FF"
                            BorderBrush="#BFDBFE" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#0284C7"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="TableCreater" FontSize="24" FontWeight="ExtraBold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Mühasibatlıq Sistemi" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Instruction -->
                <TextBlock Text="Təhlükəsizlik Kodu" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>

                <!-- Password Input Container -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hidden text input for Show Password mode -->
                    <TextBox x:Name="TxtVisiblePassword" Grid.Column="0" FontSize="15" Padding="12,10"
                             BorderBrush="#CBD5E1" Visibility="Collapsed" KeyDown="Input_KeyDown"/>

                    <!-- PasswordBox for secure input -->
                    <PasswordBox x:Name="TxtPassword" Grid.Column="0" FontSize="15" Padding="12,10"
                                 BorderBrush="#CBD5E1" KeyDown="Input_KeyDown"/>

                    <!-- Toggle Show/Hide Password Button -->
                    <Button x:Name="BtnTogglePassword" Grid.Column="1" Click="BtnTogglePassword_Click"
                            Padding="10,0" Margin="4,0,0,0" Background="#F1F5F9" BorderBrush="#CBD5E1"
                            BorderThickness="1" Cursor="Hand" ToolTip="Şifrəni göstər/gizlə">
                        <TextBlock x:Name="IconTogglePassword" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#64748B"/>
                    </Button>
                </Grid>

                <!-- Error Message -->
                <TextBlock x:Name="TxtError" Text="Daxil edilən kod yanlışdır!"
                           Foreground="#DC2626" FontSize="12" FontWeight="SemiBold"
                           Visibility="Collapsed" Margin="0,4,0,12"/>

                <!-- Login Button -->
                <Button x:Name="BtnLogin" Content="Daxil Ol" Click="BtnLogin_Click"
                        Margin="0,12,0,0" Padding="0,12" Background="#0284C7" Foreground="White"
                        BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand" HorizontalAlignment="Stretch">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Footer Hint -->
                <TextBlock Text="🔒 Verilənlər bazası və bütün məlumatlar 256-bit açarla şifrələnir."
                           FontSize="11" Foreground="#94A3B8" TextAlignment="Center" Margin="0,20,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
