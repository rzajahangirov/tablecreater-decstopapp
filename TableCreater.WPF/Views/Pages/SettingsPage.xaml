<UserControl x:Class="TableCreater.WPF.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             Background="#F8FAFC">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <!-- ========================================================================= -->
            <!-- 1. TƏHLÜKƏSİZLİK VƏ ŞİFRƏ (PIN) İDARƏETMƏSİ -->
            <!-- ========================================================================= -->
            <Border Background="White" CornerRadius="10" Padding="28" Margin="0,0,0,24"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.04" Color="#0F172A"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="40" Height="40" CornerRadius="20" Background="#EFF6FF"
                                BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,12,0">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#0284C7"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Təhlükəsizlik və Giriş Kodu" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Giriş kodunu yeniləyin — bütün mövcud və gələcək məlumatlar qorunur" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Kodu dəyişdirmək üçün cari kodunuzu və yeni kodu daxil edin. Bütün bazanız avtomatik olaraq yeni açarla yenidən şifrələnəcək."
                               FontSize="13" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="19"/>

                    <!-- PIN Inputs Grid -->
                    <Grid Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Old PIN -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Cari Kod:" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#334155" VerticalAlignment="Center" Margin="0,0,0,14"/>
                        <PasswordBox x:Name="TxtOldPin" Grid.Row="0" Grid.Column="1" FontSize="14" Padding="10,8"
                                     BorderBrush="#CBD5E1" Margin="0,0,0,14" PasswordChanged="PinInput_PasswordChanged"/>

                        <!-- New PIN -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Yeni Kod:" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#334155" VerticalAlignment="Center" Margin="0,0,0,14"/>
                        <PasswordBox x:Name="TxtNewPin" Grid.Row="1" Grid.Column="1" FontSize="14" Padding="10,8"
                                     BorderBrush="#CBD5E1" Margin="0,0,0,14" PasswordChanged="PinInput_PasswordChanged"/>

                        <!-- Confirm New PIN -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Yeni Kodun Təkrarı:" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#334155" VerticalAlignment="Center" Margin="0,0,0,14"/>
                        <PasswordBox x:Name="TxtConfirmPin" Grid.Row="2" Grid.Column="1" FontSize="14" Padding="10,8"
                                     BorderBrush="#CBD5E1" Margin="0,0,0,14" PasswordChanged="PinInput_PasswordChanged"/>
                    </Grid>

                    <!-- Error / Success Messages -->
                    <TextBlock Text="{Binding PinErrorMessage}" Foreground="#DC2626" FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,12" TextWrapping="Wrap"
                               Visibility="{Binding PinErrorMessage, Converter={StaticResource NullToVisConverter}}"/>

                    <TextBlock Text="{Binding PinSuccessMessage}" Foreground="#16A34A" FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,12" TextWrapping="Wrap"
                               Visibility="{Binding PinSuccessMessage, Converter={StaticResource NullToVisConverter}}"/>

                    <!-- Submit Button -->
                    <Button Content="Kodu Yenilə" Click="BtnChangePin_Click"
                            Padding="24,10" Background="#0284C7" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Left" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ========================================================================= -->
            <!-- 2. BAZA YEDƏKLƏNMƏSİ VƏ BƏRPASI (BACKUP & RESTORE) -->
            <!-- ========================================================================= -->
            <Border Background="White" CornerRadius="10" Padding="28" Margin="0,0,0,24"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.04" Color="#0F172A"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="40" Height="40" CornerRadius="20" Background="#F0FDF4"
                                BorderBrush="#BBF7D0" BorderThickness="1" Margin="0,0,12,0">
                            <TextBlock Text="&#xEC32;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#16A34A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Məlumat Bazasının Yedəklənməsi və Bərpası" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Bütün əməliyyatlarınızı arxivləşdirin və ehtiyac olduqda bərpa edin" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Status Info Badges -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <TextBlock Text="Baza Faylı:" FontSize="12" Foreground="#64748B" Margin="0,0,6,0"/>
                                <TextBlock Text="tablecreater.db" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Column="2">
                                <TextBlock Text="Şifrələmə:" FontSize="12" Foreground="#64748B" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding EncryptionStatus}" FontSize="12" FontWeight="Bold" Foreground="#0284C7"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Backup Action Buttons -->
                    <WrapPanel Margin="0,0,0,20">
                        <Button Content="İndi Avtomatik Yedəklə" Command="{Binding CreateAutoBackupCommand}"
                                Padding="16,10" Margin="0,0,10,10" Background="#16A34A" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" FontSize="13" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="Fərqli Yerdə Saxla..." Click="BtnBackupAs_Click"
                                Padding="16,10" Margin="0,0,10,10" Background="#F1F5F9" Foreground="#334155"
                                BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" FontSize="13" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="Bazanı Bərpa Et..." Click="BtnRestore_Click"
                                Padding="16,10" Margin="0,0,10,10" Background="#FEF2F2" Foreground="#DC2626"
                                BorderBrush="#FECACA" BorderThickness="1" FontWeight="SemiBold" FontSize="13" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="Yedəklər Qovluğu" Command="{Binding OpenBackupFolderCommand}"
                                Padding="16,10" Margin="0,0,10,10" Background="#F8FAFC" Foreground="#475569"
                                BorderBrush="#E2E8F0" BorderThickness="1" FontSize="13" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                        </Button>
                    </WrapPanel>

                    <!-- Backup Result Messages -->
                    <TextBlock Text="{Binding BackupSuccessMessage}" Foreground="#16A34A" FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,14" TextWrapping="Wrap"
                               Visibility="{Binding BackupSuccessMessage, Converter={StaticResource NullToVisConverter}}"/>

                    <TextBlock Text="{Binding BackupErrorMessage}" Foreground="#DC2626" FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,14" TextWrapping="Wrap"
                               Visibility="{Binding BackupErrorMessage, Converter={StaticResource NullToVisConverter}}"/>

                    <!-- Recent Backups List -->
                    <TextBlock Text="Mövcud Yedəklər:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" MaxHeight="160">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ExistingBackups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,8" BorderBrush="#EDF2F7" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CreationTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                           FontSize="11" Foreground="#64748B" Margin="16,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Length, StringFormat='{}{0:N0} bayt'}"
                                                           FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ========================================================================= -->
            <!-- 3. PROQRAM HAQQINDA -->
            <!-- ========================================================================= -->
            <Border Background="White" CornerRadius="10" Padding="28" Margin="0,0,0,24"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.04" Color="#0F172A"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Proqram Haqqında" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" Foreground="#0F172A"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Tətbiq:" FontSize="13" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" Text="TableCreater Mühasibatlıq Sistemi" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Versiya:" FontSize="13" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" Text="v1.0.0" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Təhlükəsizlik Zərfi:" FontSize="13" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" Text="PBKDF2 (SHA-256 100k) + AES-256-GCM + SQLCipher" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Platforma:" FontSize="13" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" Text=".NET 9 Windows Desktop (WPF)" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
