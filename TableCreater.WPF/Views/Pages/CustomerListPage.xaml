<UserControl x:Class="TableCreater.WPF.Views.Pages.CustomerListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019">

    <Grid Margin="24,16" Background="White">
        <Grid.RowDefinitions>
            <!-- Toolbar: Search + Actions -->
            <RowDefinition Height="Auto"/>
            <!-- Data Grid -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search & Filter Bar -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                <TextBox x:Name="TxtSearch"
                         Width="260"
                         ui:ControlHelper.PlaceholderText="Ad və ya telefon ilə axtar..."
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="TxtSearch_KeyDown"
                         FontSize="14"
                         Padding="12,10"
                         BorderBrush="#D1D1D1"/>

                <Button Content="Axtar"
                        Click="BtnSearch_Click"
                        Margin="8,0,0,0"
                        Padding="20,10"
                        Background="#005FB8"
                        Foreground="White"
                        BorderThickness="0"
                        Style="{StaticResource DefaultButtonStyle}"/>

                <ComboBox SelectedValue="{Binding StatusFilter, Mode=TwoWay}"
                          SelectedValuePath="Tag"
                          Margin="12,0,0,0" Padding="12,8" FontSize="13" VerticalAlignment="Center">
                    <ComboBoxItem Content="Hamısı (Aktiv əvvəl)" Tag="All" IsSelected="True"/>
                    <ComboBoxItem Content="Yalnız Aktiv" Tag="Active"/>
                    <ComboBoxItem Content="Yalnız Deaktiv" Tag="Inactive"/>
                </ComboBox>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Click="BtnAdd_Click"
                        Padding="16,10"
                        Margin="0,0,8,0"
                        Background="#005FB8"
                        Foreground="White"
                        BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Yeni Müştəri" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnToggleStatus"
                        Click="BtnToggleStatus_Click"
                        Padding="14,10"
                        Margin="0,0,8,0"
                        Background="#F1F5F9"
                        Foreground="#334155"
                        BorderThickness="1"
                        BorderBrush="#CBD5E1"
                        ToolTip="Seçilmiş müştərinin Aktiv / Deaktiv statusunu dəyiş"
                        IsEnabled="{Binding SelectedCustomer, Converter={StaticResource NullToBoolConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Statusu Dəyiş" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnEdit"
                        Click="BtnEdit_Click"
                        Padding="16,10"
                        Margin="0,0,8,0"
                        Background="#EAEAEA"
                        Foreground="#333"
                        BorderThickness="0"
                        IsEnabled="{Binding SelectedCustomer, Converter={StaticResource NullToBoolConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Düzəliş et" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnDelete"
                        Click="BtnDelete_Click"
                        Padding="16,10"
                        Background="#FFEBEE"
                        Foreground="#C62828"
                        BorderThickness="0"
                        IsEnabled="{Binding SelectedCustomer, Converter={StaticResource NullToBoolConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Sil" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- CUSTOMER DATA GRID -->
        <Border Grid.Row="1" CornerRadius="4"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <DataGrid x:Name="CustomerGrid"
                      ItemsSource="{Binding Customers}"
                      SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F0F0"
                      BorderThickness="0"
                      FontSize="14"
                      RowHeight="48"
                      ColumnHeaderHeight="44"
                      Background="Transparent"
                      MouseDoubleClick="CustomerGrid_DoubleClick">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F9F9F9"/>
                        <Setter Property="Foreground" Value="#666"/>
                        <Setter Property="Padding" Value="16,0"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                        <Setter Property="SeparatorVisibility" Value="Collapsed"/>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#F0F7FF"/>
                                <Setter Property="Foreground" Value="#005FB8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Detallara bax" Click="MenuCustomerDetails_Click"/>
                        <MenuItem Header="Düzəliş et" Click="MenuCustomerEdit_Click"/>
                        <MenuItem Header="Statusu Dəyiş" Click="MenuToggleStatus_Click"/>
                        <Separator/>
                        <MenuItem Header="Sil" Click="MenuCustomerDelete_Click" Foreground="#C62828"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70">
                         <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="16,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Müştəri Adı" Binding="{Binding Name}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="16,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="16,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Status Column -->
                    <DataGridTemplateColumn Header="Status" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{Binding Type, Converter={StaticResource CustomerTypeToBgConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Fill="{Binding Type, Converter={StaticResource CustomerTypeToFgConverter}}"/>
                                        <TextBlock Text="{Binding Type, Converter={StaticResource CustomerTypeToTextConverter}}"
                                                   FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding Type, Converter={StaticResource CustomerTypeToFgConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Balans (USD)" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding BalanceUsd, StringFormat='${0:N2}'}"
                                           Foreground="{Binding BalanceUsd, Converter={StaticResource ProfitLossToColorConverter}}"
                                           FontWeight="Bold"
                                           Padding="16,0"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- STATUS BAR -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Error Message -->
            <TextBlock Grid.Column="0"
                       Text="{Binding ErrorMessage}"
                       Foreground="#D32F2F"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisConverter}}"/>

            <!-- Customer Count -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Cəmi: " FontSize="13" Foreground="#888"/>
                <TextBlock Text="{Binding Customers.Count, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#333"/>
                <TextBlock Text=" müştəri" FontSize="13" Foreground="#888"/>
            </StackPanel>
        </Grid>

        <!-- ADD/EDIT DIALOG OVERLAY -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVisConverter}}"
                Background="#66000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="440" Padding="32"
                    CornerRadius="8"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="22" FontWeight="Bold" Margin="0,0,0,24" Foreground="#222">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Yeni Müştəri"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Text" Value="Müştəri Məlumatlarını Yenilə"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Ad Soyad" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                    <TextBox Text="{Binding DialogName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="12" Margin="0,0,0,20"
                             BorderBrush="#D1D1D1"
                             ui:ControlHelper.PlaceholderText="Müştərinin tam adı"/>

                    <TextBlock Text="Telefon" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                    <TextBox Text="{Binding DialogPhone, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="12" Margin="0,0,0,20"
                             BorderBrush="#D1D1D1"
                             ui:ControlHelper.PlaceholderText="Məs: +994 50 123 45 67"/>

                    <!-- Status (Shown only on Edit) -->
                    <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,20">
                        <TextBlock Text="Status" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                        <ComboBox ItemsSource="{Binding CustomerTypes}"
                                  SelectedItem="{Binding DialogType, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  FontSize="14" Padding="12,10"
                                  BorderBrush="#D1D1D1">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource CustomerTypeToTextConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Initial Balance (Shown only on Create) -->
                    <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}" Margin="0,0,0,24">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="İlkin Balans (istəyə bağlı)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                                <ui:NumberBox Value="{Binding DialogInitialBalance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SpinButtonPlacementMode="Compact"
                                              Minimum="0"
                                              HorizontalAlignment="Stretch" Padding="8,6"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Valyuta" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                                <ComboBox ItemsSource="{Binding PaymentCurrencies}"
                                          SelectedItem="{Binding DialogInitialBalanceCurrency, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          FontSize="14" Padding="10,8"
                                          BorderBrush="#D1D1D1">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumToUpperConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel Visibility="{Binding DialogInitialBalanceCurrency, Converter={StaticResource EnumEqualsToVisConverter}, ConverterParameter=Rub}">
                            <TextBlock Text="RUB / USD Məzənnəsi (1 RUB = ? USD)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#555"/>
                            <ui:NumberBox Value="{Binding DialogInitialBalanceExchangeRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SpinButtonPlacementMode="Compact"
                                          Minimum="0"
                                          HorizontalAlignment="Stretch" Padding="8,6"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Ləğv et"
                                Click="BtnCancelDialog_Click"
                                HorizontalAlignment="Stretch"
                                Padding="0,12" Margin="0,0,8,0"
                                Background="Transparent"
                                Foreground="#666"/>

                        <Button Grid.Column="1" Content="Yadda saxla"
                                Click="BtnSaveDialog_Click"
                                HorizontalAlignment="Stretch"
                                Padding="0,12" Margin="8,0,0,0"
                                Background="#005FB8"
                                Foreground="White"
                                BorderThickness="0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Loading Indicator -->
        <ui:ProgressRing Grid.Row="1"
                         IsActive="{Binding IsLoading}"
                         Width="48" Height="48"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="#005FB8"/>
    </Grid>
</UserControl>
