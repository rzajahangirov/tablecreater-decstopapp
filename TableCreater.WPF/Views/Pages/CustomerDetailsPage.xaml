<UserControl x:Class="TableCreater.WPF.Views.Pages.CustomerDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:enums="clr-namespace:TableCreater.WPF.Enums">

    <Grid Background="White">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>

                <!-- Back Button -->
                <Button Click="BtnBack_Click" Padding="10,6" Margin="0,0,0,12"
                        Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#005FB8"/>
                        <TextBlock Text="Geri qayıt" FontSize="13" Foreground="#005FB8" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Messages -->
                <Border Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisConverter}}"
                        Background="#E8F5E9" BorderBrush="#2E7D32" BorderThickness="1"
                        CornerRadius="4" Padding="14,10" Margin="0,0,0,16">
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#2E7D32" FontSize="13" FontWeight="SemiBold"/>
                </Border>
                <Border Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisConverter}}"
                        Background="#FFEBEE" BorderBrush="#C62828" BorderThickness="1"
                        CornerRadius="4" Padding="14,10" Margin="0,0,0,16">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" FontSize="13" FontWeight="SemiBold"/>
                </Border>

                <!-- DASHBOARD CARDS -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Transactions Count -->
                    <Border Grid.Column="0" Margin="0,0,8,0" Padding="20,16" Background="#F0F7FF" BorderBrush="#BBDEFB" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Tranzaksiyalar" FontSize="11" Foreground="#5C6BC0" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding TransactionCount}" FontSize="26" FontWeight="Bold" Foreground="#1A237E"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Expense -->
                    <Border Grid.Column="1" Margin="4,0" Padding="20,16" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Ümumi Xərc (USD)" FontSize="11" Foreground="#F57F17" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding TotalExpenseUsd, StringFormat='$ {0:N2}'}" FontSize="22" FontWeight="Bold" Foreground="#E65100"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Paid -->
                    <Border Grid.Column="2" Margin="4,0" Padding="20,16" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Ümumi Ödəniş (USD)" FontSize="11" Foreground="#2E7D32" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding TotalPaidUsd, StringFormat='$ {0:N2}'}" FontSize="22" FontWeight="Bold" Foreground="#1B5E20"/>
                        </StackPanel>
                    </Border>

                    <!-- Remaining Debt -->
                    <Border Grid.Column="3" Margin="8,0,0,0" Padding="20,16" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Qalıq Borc (USD)" FontSize="11" Foreground="#666" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding RemainingDebtUsd, StringFormat='$ {0:N2}'}" FontSize="22" FontWeight="Bold"
                                       Foreground="{Binding DebtStatusColor}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- TOOLBAR -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#005FB8"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding CustomerName}" FontSize="18" FontWeight="Bold" Foreground="#222" VerticalAlignment="Center"/>
                        <TextBlock Text=" — " FontSize="14" Foreground="#999" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CustomerPhone}" FontSize="14" Foreground="#666" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Click="BtnNewTransaction_Click"
                            Padding="16,10" Background="#005FB8" Foreground="White" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Yeni Tranzaksiya" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- TRANSACTIONS DATA GRID -->
                <Border CornerRadius="4" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                    <DataGrid x:Name="TransactionGrid"
                              ItemsSource="{Binding Transactions}"
                              SelectedItem="{Binding SelectedTransaction, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F0F0F0"
                              BorderThickness="0"
                              FontSize="12"
                              RowHeight="42"
                              ColumnHeaderHeight="38"
                              Background="Transparent"
                              HorizontalScrollBarVisibility="Auto"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F5F7FA"/>
                                <Setter Property="Foreground" Value="#555"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#E8E8E8"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                        <Setter Property="Foreground" Value="#000000"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                        <Setter Property="Foreground" Value="#000000"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- Tarix -->
                            <DataGridTextColumn Header="Tarix" Binding="{Binding TransactionDate}" Width="90"/>

                            <!-- Məhsul -->
                            <DataGridTextColumn Header="Məhsul" Binding="{Binding ProductName}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Firma -->
                            <DataGridTextColumn Header="Firma" Binding="{Binding ReceivingCompany}" Width="120"/>

                            <!-- Çəki -->
                            <DataGridTextColumn Header="Çəki (T)" Binding="{Binding WeightTon, StringFormat='{}{0:N2}'}" Width="75"/>

                            <!-- Vahid Qiymət RUB -->
                            <DataGridTextColumn Header="Qiymət/T (₽)" Binding="{Binding PricePerTonRub, StringFormat='{}{0:N0}'}" Width="90"/>

                            <!-- Nəqliyyat Növü -->
                            <DataGridTextColumn Header="Nəql." Binding="{Binding TransportType}" Width="60"/>

                            <!-- Maşın/Gəmi Sayı -->
                            <DataGridTextColumn Header="Sayı" Binding="{Binding VehicleCount}" Width="50"/>

                            <!-- Nəqliyyat Qiyməti -->
                            <DataGridTextColumn Header="Nəql. Qiym." Binding="{Binding PricePerVehicle, StringFormat='{}{0:N0}'}" Width="85"/>

                            <!-- Ödənilən Məbləğ + Valyuta -->
                            <DataGridTemplateColumn Header="Ödəniş" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{Binding PaidAmount, StringFormat='{}{0:N0}', Mode=OneWay}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding PaidCurrency, Mode=OneWay}" FontSize="10" Foreground="#999"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Ümumi Xərc USD -->
                            <DataGridTextColumn Header="Xərc (USD)" Binding="{Binding HistoricalTotalExpenseUsd, StringFormat='$ {0:N2}'}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#E65100"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Qalıq Borc USD -->
                            <DataGridTemplateColumn Header="Borc (USD)" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding HistoricalRemainingDebtUsd, StringFormat='$ {0:N2}'}"
                                                   FontWeight="Bold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#888"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HistoricalRemainingDebtUsd, Converter={StaticResource NullToBoolConverter}}" Value="True">
                                                            <Setter Property="Foreground" Value="#888"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status -->
                            <DataGridTemplateColumn Header="Status" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFF8E1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Background" Value="#E8F5E9"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Gözləmədə"/>
                                                        <Setter Property="Foreground" Value="#F57F17"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Text" Value="Tamamlanıb"/>
                                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Sənəd -->
                            <DataGridTemplateColumn Header="Sənəd" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="BtnOpenDocument_Click"
                                                Tag="{Binding DocumentPath}"
                                                Visibility="{Binding DocumentPath, Converter={StaticResource NullToVisConverter}}"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="4" Cursor="Hand" ToolTip="Sənədə bax">
                                            <TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#005FB8"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions: Edit & Delete -->
                            <DataGridTemplateColumn Header="Əməliyyat" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Click="BtnEditTransaction_Click"
                                                    Tag="{Binding Id}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Padding="6,4" Cursor="Hand" ToolTip="Düzəliş et" Margin="0,0,4,0">
                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#005FB8"/>
                                            </Button>
                                            <Button Click="BtnDeleteTransaction_Click"
                                                    Tag="{Binding Id}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Padding="6,4" Cursor="Hand" ToolTip="Sil">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C62828"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"
                Background="#AAFFFFFF">
            <ui:ProgressRing IsActive="{Binding IsLoading}" Width="48" Height="48"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#005FB8"/>
        </Border>
    </Grid>
</UserControl>
