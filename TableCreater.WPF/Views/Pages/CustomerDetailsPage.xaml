<UserControl x:Class="TableCreater.WPF.Views.Pages.CustomerDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:enums="clr-namespace:TableCreater.WPF.Enums">

    <Grid Background="White">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>

                <!-- Back Button -->
                <Button Click="BtnBack_Click" Padding="10,6" Margin="0,0,0,12"
                        Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#005FB8"/>
                        <TextBlock Text="Geri qayıt" FontSize="13" Foreground="#005FB8" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Messages -->
                <Border Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisConverter}}"
                        Background="#E8F5E9" BorderBrush="#2E7D32" BorderThickness="1"
                        CornerRadius="4" Padding="14,10" Margin="0,0,0,16">
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#2E7D32" FontSize="13" FontWeight="SemiBold"/>
                </Border>
                <Border Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisConverter}}"
                        Background="#FFEBEE" BorderBrush="#C62828" BorderThickness="1"
                        CornerRadius="4" Padding="14,10" Margin="0,0,0,16">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" FontSize="13" FontWeight="SemiBold"/>
                </Border>

                <!-- DASHBOARD CARDS -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Customer Balance (Primary Card) -->
                    <Border Grid.Column="0" Margin="0,0,6,0" Padding="18,14" Background="#F0FDFC" BorderBrush="#99F6E4" BorderThickness="1.5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Müştəri Balansı (USD)" FontSize="11" Foreground="#0F766E" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding CustomerBalanceUsd, StringFormat='${0:N2}'}" FontSize="24" FontWeight="ExtraBold"
                                       Foreground="{Binding BalanceStatusColor}"/>
                        </StackPanel>
                    </Border>

                    <!-- Transactions Count -->
                    <Border Grid.Column="1" Margin="3,0" Padding="18,14" Background="#F0F7FF" BorderBrush="#BBDEFB" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Tranzaksiyalar" FontSize="11" Foreground="#5C6BC0" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding TransactionCount}" FontSize="24" FontWeight="Bold" Foreground="#1A237E"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Expense -->
                    <Border Grid.Column="2" Margin="3,0" Padding="18,14" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Ümumi Xərc (USD)" FontSize="11" Foreground="#F57F17" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding TotalExpenseUsd, StringFormat='${0:N2}'}" FontSize="20" FontWeight="Bold" Foreground="#E65100"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Paid -->
                    <Border Grid.Column="3" Margin="3,0" Padding="18,14" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Ümumi Ödəniş (USD)" FontSize="11" Foreground="#2E7D32" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding TotalPaidUsd, StringFormat='${0:N2}'}" FontSize="20" FontWeight="Bold" Foreground="#1B5E20"/>
                        </StackPanel>
                    </Border>

                    <!-- Gəlir (Benefit / Profit) -->
                    <Border Grid.Column="4" Margin="6,0,0,0" Padding="18,14" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Gəlir (USD)" FontSize="11" Foreground="#666" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding RemainingDebtUsd, StringFormat='${0:N2}'}" FontSize="20" FontWeight="Bold"
                                       Foreground="{Binding DebtStatusColor}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- TOOLBAR -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#005FB8"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding CustomerName}" FontSize="18" FontWeight="Bold" Foreground="#222" VerticalAlignment="Center"/>
                        <TextBlock Text=" — " FontSize="14" Foreground="#999" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CustomerPhone}" FontSize="14" Foreground="#666" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Click="BtnNewTransaction_Click"
                            Padding="16,10" Background="#005FB8" Foreground="White" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Yeni Tranzaksiya" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ===== TRANSACTION STATISTICS (Paid/Unpaid) ===== -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Paid Count Badge -->
                    <Border Grid.Column="0" Background="#E8F5E9" CornerRadius="14" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                       Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Ödənilib:" FontSize="12" Foreground="#2E7D32" FontWeight="SemiBold" 
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding PaidTransactionCount}" FontSize="14" FontWeight="ExtraBold" 
                                       Foreground="#1B5E20" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Unpaid Count Badge -->
                    <Border Grid.Column="1" Background="#FFEBEE" CornerRadius="14" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                       Foreground="#C62828" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Ödənilməyib:" FontSize="12" Foreground="#C62828" FontWeight="SemiBold" 
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding UnpaidTransactionCount}" FontSize="14" FontWeight="ExtraBold" 
                                       Foreground="#B71C1C" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Filtered Count (shown when filter active) -->
                    <Border Grid.Column="2" Background="#E3F2FD" CornerRadius="14" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                       Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Göstərilən:" FontSize="12" Foreground="#1565C0" FontWeight="SemiBold" 
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding FilteredTransactionCount}" FontSize="14" FontWeight="ExtraBold" 
                                       Foreground="#0D47A1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== TRANSACTION FILTER / SEARCH PANEL ===== -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" 
                        Padding="16,12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Filters -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Date From -->
                            <TextBlock Grid.Column="0" Text="Tarixdən:" FontSize="12" Foreground="#64748B" 
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding TxFilterDateFrom, Mode=TwoWay}" 
                                        FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center"/>

                            <!-- Date To -->
                            <TextBlock Grid.Column="2" Text="Tarixə:" FontSize="12" Foreground="#64748B" 
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker Grid.Column="3" SelectedDate="{Binding TxFilterDateTo, Mode=TwoWay}" 
                                        FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center"/>

                            <!-- Payment Status -->
                            <TextBlock Grid.Column="4" Text="Ödəniş:" FontSize="12" Foreground="#64748B" 
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="5" ItemsSource="{Binding PaymentStatusFilterOptions}" 
                                      SelectedItem="{Binding TxFilterPaymentStatus, Mode=TwoWay}"
                                      FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center" Padding="8,5">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Converter={StaticResource PaymentStatusToTextConverter}}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="Hamısı"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Shipment Status -->
                            <TextBlock Grid.Column="6" Text="Status:" FontSize="12" Foreground="#64748B" 
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="7" ItemsSource="{Binding ShipmentStatusFilterOptions}" 
                                      SelectedItem="{Binding TxFilterShipmentStatus, Mode=TwoWay}"
                                      FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center" Padding="8,5">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Converter={StaticResource ShipmentStatusToTextConverter}}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="Hamısı"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Search box -->
                            <TextBox Grid.Column="8" 
                                     Text="{Binding TxSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="12" Padding="8,5" VerticalAlignment="Center"
                                     ui:ControlHelper.PlaceholderText="🔍 Məhsul, göndərən, qəbul edən..."
                                     Margin="0,0,8,0" BorderBrush="#D1D5DB"/>

                            <!-- Apply Filter Button -->
                            <Button Grid.Column="9" Command="{Binding ApplyTransactionFiltersCommand}"
                                    Padding="12,6" Background="#005FB8" Foreground="White" 
                                    BorderThickness="0" VerticalAlignment="Center" Cursor="Hand" Margin="0,0,4,0"
                                    ToolTip="Filtrləri tətbiq et">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Filtr" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <!-- Clear Filter Button -->
                            <Button Grid.Column="10" Command="{Binding ClearTransactionFiltersCommand}"
                                    Padding="12,6" Background="Transparent" Foreground="#64748B" 
                                    BorderBrush="#CBD5E1" BorderThickness="1" VerticalAlignment="Center" Cursor="Hand"
                                    ToolTip="Filtrləri təmizlə">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Təmizlə" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- TRANSACTIONS DATA GRID -->
                <Border CornerRadius="4" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,24">
                    <DataGrid x:Name="TransactionGrid"
                              ItemsSource="{Binding Transactions}"
                              SelectedItem="{Binding SelectedTransaction, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F0F0F0"
                              BorderThickness="0"
                              FontSize="12"
                              RowHeight="42"
                              ColumnHeaderHeight="38"
                              Background="Transparent"
                              HorizontalScrollBarVisibility="Auto"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F5F7FA"/>
                                <Setter Property="Foreground" Value="#555"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#E8E8E8"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                        <Setter Property="Foreground" Value="#000000"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                        <Setter Property="Foreground" Value="#000000"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- Tarix -->
                            <DataGridTextColumn Header="Tarix" Binding="{Binding TransactionDate}" Width="90"/>

                            <!-- Məhsul -->
                            <DataGridTextColumn Header="Məhsul" Binding="{Binding ProductName}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Göndərən Firma -->
                            <DataGridTextColumn Header="Göndərən" Binding="{Binding SendingCompany}" Width="100"/>

                            <!-- Qəbul Edən Firma -->
                            <DataGridTextColumn Header="Qəbul Edən" Binding="{Binding ReceivingCompany}" Width="100"/>

                            <!-- Çəki -->
                            <DataGridTextColumn Header="Çəki (T)" Binding="{Binding WeightTon, StringFormat='{}{0:N2}'}" Width="75"/>

                            <!-- Vahid Qiymət RUB -->
                            <DataGridTextColumn Header="Qiymət/T (₽)" Binding="{Binding PricePerTonRub, StringFormat='{}{0:N0}'}" Width="90"/>

                            <!-- Nəqliyyat Növü -->
                            <DataGridTextColumn Header="Nəql." Binding="{Binding TransportType}" Width="65"/>

                            <!-- Sayı -->
                            <DataGridTextColumn Header="Sayı" Binding="{Binding VehicleCount}" Width="50"/>

                            <!-- Nəqliyyat Qiyməti -->
                            <DataGridTemplateColumn Header="Nəql. Qiym." Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{Binding PricePerVehicle, StringFormat='{}{0:N0}', Mode=OneWay}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding TransportCurrency, Converter={StaticResource EnumToUpperConverter}, Mode=OneWay}" FontSize="10" Foreground="#888"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Əlavə Xərc -->
                            <DataGridTemplateColumn Header="Əlavə Xərc" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" ToolTip="{Binding AdditionalExpenseDescription}">
                                            <Run Text="{Binding AdditionalExpenseAmount, StringFormat='{}{0:N0}', Mode=OneWay}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding AdditionalExpenseCurrency, Converter={StaticResource EnumToUpperConverter}, Mode=OneWay}" FontSize="10" Foreground="#888"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Ödənilən Məbləğ + Valyuta -->
                            <DataGridTemplateColumn Header="Ödəniş" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{Binding PaidAmount, StringFormat='{}{0:N0}', Mode=OneWay}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding PaidCurrency, Converter={StaticResource EnumToUpperConverter}, Mode=OneWay}" FontSize="10" Foreground="#999"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Ödəniş Statusu -->
                            <DataGridTemplateColumn Header="Ödəniş Statusu" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left"
                                                Background="{Binding PaymentStatus, Converter={StaticResource PaymentStatusToBgConverter}}">
                                            <TextBlock Text="{Binding PaymentStatus, Converter={StaticResource PaymentStatusToTextConverter}}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding PaymentStatus, Converter={StaticResource PaymentStatusToFgConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Ümumi Xərc USD -->
                            <DataGridTextColumn Header="Xərc (USD)" Binding="{Binding HistoricalTotalExpenseUsd, StringFormat='${0:N2}'}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#E65100"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Qazanc USD -->
                            <DataGridTextColumn Header="Qazanc (USD)" Binding="{Binding HistoricalUserProfitUsd, StringFormat='${0:N2}'}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#15803D"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Hesablanan USD -->
                            <DataGridTextColumn Header="Hesablanan (USD)" Binding="{Binding HistoricalCustomerBilledUsd, StringFormat='${0:N2}'}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#1A237E"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Balans Dəyişimi USD -->
                            <DataGridTemplateColumn Header="Balans Təsiri" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding HistoricalBalanceDeltaUsd, StringFormat='${0:+#,##0.00;-#,##0.00;0.00}'}"
                                                   Foreground="{Binding HistoricalBalanceDeltaUsd, Converter={StaticResource ProfitLossToColorConverter}}"
                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status -->
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="BtnChangeStatus_Click"
                                                Tag="{Binding}"
                                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                                ToolTip="{Binding TrackingDatesSummary}">
                                            <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Left"
                                                    Background="{Binding ShipmentStatus, Converter={StaticResource ShipmentStatusToBgConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ShipmentStatus, Converter={StaticResource ShipmentStatusToGlyphConverter}}"
                                                               FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0"
                                                               Foreground="{Binding ShipmentStatus, Converter={StaticResource ShipmentStatusToFgConverter}}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ShipmentStatusDisplay}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding ShipmentStatus, Converter={StaticResource ShipmentStatusToFgConverter}}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Sənəd -->
                            <DataGridTemplateColumn Header="Sənəd" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="BtnOpenDocument_Click"
                                                Tag="{Binding DocumentPath}"
                                                Visibility="{Binding DocumentPath, Converter={StaticResource NullToVisConverter}}"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="4" Cursor="Hand" ToolTip="Sənədə bax">
                                            <TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#005FB8"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions: Status, Edit & Delete -->
                            <DataGridTemplateColumn Header="Əməliyyat" Width="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Click="BtnChangeStatus_Click"
                                                    Tag="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Padding="6,4" Cursor="Hand" ToolTip="Göndərmə statusunu dəyiş" Margin="0,0,4,0">
                                                <TextBlock Text="&#xE7EC;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#5E35B1"/>
                                            </Button>
                                            <Button Click="BtnEditTransaction_Click"
                                                    Tag="{Binding Id}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Padding="6,4" Cursor="Hand" ToolTip="Düzəliş et" Margin="0,0,4,0">
                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#005FB8"/>
                                            </Button>
                                            <Button Click="BtnDeleteTransaction_Click"
                                                    Tag="{Binding Id}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Padding="6,4" Cursor="Hand" ToolTip="Sil">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C62828"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- BALANS ƏMƏLİYYATLARI (Manual Deposit / Withdrawal / Adjustment) -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#005FB8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Balans Əməliyyatı (Mədaxil / Məxaric / Düzəliş)" FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding CustomerBalanceUsd, StringFormat='Cari Balans: ${0:N2}'}"
                                       FontSize="14" FontWeight="Bold" Foreground="{Binding BalanceStatusColor}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Əməliyyat Növü -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Əməliyyat Növü" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding ManualBalanceTypes}"
                                          SelectedItem="{Binding AdjustmentType, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" Padding="8,6" FontSize="13">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource BalanceTypeToTextConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Məbləğ -->
                            <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                <TextBlock Text="Məbləğ" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <ui:NumberBox Value="{Binding AdjustmentAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SpinButtonPlacementMode="Compact" Minimum="0"
                                              HorizontalAlignment="Stretch" Padding="8,6"/>
                            </StackPanel>

                            <!-- Valyuta -->
                            <StackPanel Grid.Column="2" Margin="4,0,8,0">
                                <TextBlock Text="Valyuta" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding PaymentCurrencies}"
                                          SelectedItem="{Binding AdjustmentCurrency, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" Padding="8,6" FontSize="13">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumToUpperConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Məzənnə (RUB olduqda) -->
                            <StackPanel Grid.Column="3" Margin="4,0,8,0"
                                        Visibility="{Binding AdjustmentCurrency, Converter={StaticResource EnumEqualsToVisConverter}, ConverterParameter=Rub}">
                                <TextBlock Text="Məzənnə (USD)" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <ui:NumberBox Value="{Binding AdjustmentExchangeRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SpinButtonPlacementMode="Compact" Minimum="0"
                                              HorizontalAlignment="Stretch" Padding="8,6"/>
                            </StackPanel>

                            <!-- Təsvir / Qeyd -->
                            <StackPanel Grid.Column="4" Margin="4,0,8,0">
                                <TextBlock Text="Təsvir / Qeyd" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding AdjustmentDescription, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" FontSize="13" BorderBrush="#D1D1D1"
                                         ui:ControlHelper.PlaceholderText="Məs: Nağd mədaxil, köçürmə..."/>
                            </StackPanel>

                            <!-- Tətbiq Et Button -->
                            <Button Grid.Column="5" Command="{Binding AdjustBalanceCommand}"
                                    VerticalAlignment="Bottom" Padding="16,8"
                                    Background="#005FB8" Foreground="White" BorderThickness="0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Tətbiq Et" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- BALANS TARİXÇƏSİ (LEDGER HISTORY) -->
                <TextBlock Text="📜 Balans Tarixçəsi (Ledger)" FontSize="18" FontWeight="Bold" Margin="0,8,0,10" Foreground="#222"/>

                <!-- Balance History Filter Panel -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" 
                        Padding="16,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Date From -->
                        <TextBlock Grid.Column="0" Text="Tarixdən:" FontSize="12" Foreground="#64748B" 
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker Grid.Column="1" SelectedDate="{Binding BhFilterDateFrom, Mode=TwoWay}" 
                                    FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center"/>

                        <!-- Date To -->
                        <TextBlock Grid.Column="2" Text="Tarixə:" FontSize="12" Foreground="#64748B" 
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker Grid.Column="3" SelectedDate="{Binding BhFilterDateTo, Mode=TwoWay}" 
                                    FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center"/>

                        <!-- Apply Filter -->
                        <Button Grid.Column="5" Command="{Binding ApplyBalanceHistoryFiltersCommand}"
                                Padding="12,6" Background="#005FB8" Foreground="White" 
                                BorderThickness="0" VerticalAlignment="Center" Cursor="Hand" Margin="0,0,4,0"
                                ToolTip="Filtrləri tətbiq et">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Filtr" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <!-- Clear Filter -->
                        <Button Grid.Column="6" Command="{Binding ClearBalanceHistoryFiltersCommand}"
                                Padding="12,6" Background="Transparent" Foreground="#64748B" 
                                BorderBrush="#CBD5E1" BorderThickness="1" VerticalAlignment="Center" Cursor="Hand"
                                ToolTip="Filtrləri təmizlə">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="12" 
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Təmizlə" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border CornerRadius="4" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,32">
                    <DataGrid ItemsSource="{Binding BalanceHistories}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F0F0F0"
                              BorderThickness="0"
                              FontSize="12"
                              RowHeight="38"
                              ColumnHeaderHeight="36"
                              Background="Transparent"
                              HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8F9FA"/>
                                <Setter Property="Foreground" Value="#555"/>
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- Tarix -->
                            <DataGridTextColumn Header="Tarix" Binding="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Əməliyyat Növü -->
                            <DataGridTemplateColumn Header="Əməliyyat Növü" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Type, Converter={StaticResource BalanceTypeToTextConverter}}"
                                                   Foreground="{Binding Type, Converter={StaticResource BalanceTypeToColorConverter}}"
                                                   FontWeight="SemiBold"
                                                   Padding="12,0"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Müştəri Ödənişi (tranzaksiya vasitəsilə olduqda) -->
                            <DataGridTemplateColumn Header="Müştəri Ödənişi" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Padding="12,0" VerticalAlignment="Center" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="—"/>
                                                    <Setter Property="Foreground" Value="#BBB"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TransactionPaidAmountUsd, Converter={StaticResource NullToBoolConverter}}" Value="True">
                                                            <Setter Property="Text" Value="{Binding TransactionPaidAmountUsd, StringFormat='${0:N2}'}"/>
                                                            <Setter Property="Foreground" Value="#1976D2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Dəyişiklik Məbləği -->
                            <DataGridTemplateColumn Header="Məbləğ (USD)" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AmountUsd, StringFormat='${0:+#,##0.00;-#,##0.00;0.00}'}"
                                                   Foreground="{Binding AmountUsd, Converter={StaticResource ProfitLossToColorConverter}}"
                                                   FontWeight="Bold"
                                                   Padding="12,0"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Əməliyyatdan Sonrakı Balans -->
                            <DataGridTemplateColumn Header="Yekun Balans" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BalanceAfterUsd, StringFormat='${0:N2}'}"
                                                   Foreground="{Binding BalanceAfterUsd, Converter={StaticResource ProfitLossToColorConverter}}"
                                                   FontWeight="Bold"
                                                   Padding="12,0"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Qeyd / Təsvir -->
                            <DataGridTextColumn Header="Qeyd / Təsvir" Binding="{Binding Description}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#555"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"
                Background="#AAFFFFFF">
            <ui:ProgressRing IsActive="{Binding IsLoading}" Width="48" Height="48"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#005FB8"/>
        </Border>
    </Grid>
</UserControl>
