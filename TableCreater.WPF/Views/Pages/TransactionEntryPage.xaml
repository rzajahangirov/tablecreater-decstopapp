<UserControl x:Class="TableCreater.WPF.Views.Pages.TransactionEntryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             Focusable="True"
             PreviewMouseDown="Page_PreviewMouseDown"
             KeyDown="UserControl_KeyDown">

    <Grid Background="White">
        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" Padding="24,16"
                      PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Form Fields -->
                    <ColumnDefinition Width="*" MinWidth="450"/>
                    <!-- Live Summary Panel -->
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: TRANSACTION FORM -->
                <StackPanel Grid.Column="0" Margin="0,0,32,0">

                    <!-- Back Button -->
                    <Button Click="BtnBack_Click" Padding="10,6" Margin="0,0,0,16"
                            Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#005FB8"/>
                            <TextBlock Text="Geri qayıt" FontSize="13" Foreground="#005FB8" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Success Message -->
                    <Border Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisConverter}}"
                            Background="#E8F5E9" BorderBrush="#2E7D32" BorderThickness="1"
                            CornerRadius="4" Padding="16,12" Margin="0,0,0,20">
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="#2E7D32" FontSize="14" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Error Message -->
                    <Border Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisConverter}}"
                            Background="#FFEBEE" BorderBrush="#C62828" BorderThickness="1"
                            CornerRadius="4" Padding="16,12" Margin="0,0,0,20">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" FontSize="14" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Section: Müştəri və Tarix -->
                    <TextBlock Text="Müştəri və Tarix" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" Foreground="#222"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Müştəri Seçimi *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <ComboBox ItemsSource="{Binding Customers}"
                                      SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      IsEditable="True"
                                      Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Stretch"
                                      FontSize="14" Padding="12,10"
                                      BorderBrush="#D1D1D1"
                                      ui:ControlHelper.PlaceholderText="Müştəri axtar və ya seç..."/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Tranzaksiya Tarixi *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <DatePicker SelectedDate="{Binding TransactionDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        HorizontalAlignment="Stretch"
                                        Padding="8,6"
                                        BorderBrush="#D1D1D1"/>
                        </StackPanel>
                    </Grid>

                    <!-- Section: Məhsul Məlumatları -->
                    <TextBlock Text="Məhsul Məlumatları" FontSize="18" FontWeight="Bold" Margin="0,12,0,16" Foreground="#222"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Məhsulun Adı *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Padding="12,10" BorderBrush="#D1D1D1"
                                     ui:ControlHelper.PlaceholderText="Məs: Dəmir Filizi"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,10,0">
                            <TextBlock Text="Qəbul Edən Firma *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <TextBox Text="{Binding ReceivingCompany, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Padding="12,10" BorderBrush="#D1D1D1"
                                     ui:ControlHelper.PlaceholderText="Məs: ABC MMC"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock Text="Göndərən Firma" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <TextBox Text="{Binding SendingCompany, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Padding="12,10" BorderBrush="#D1D1D1"
                                     ui:ControlHelper.PlaceholderText="Məs: XYZ LLC"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Çəki (Ton) *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <ui:NumberBox Value="{Binding WeightTon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SpinButtonPlacementMode="Compact"
                                          Minimum="0" SmallChange="0.1"
                                          HorizontalAlignment="Stretch" Padding="8,6"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,10,0">
                            <TextBlock Text="Qiymət/Ton (RUB) *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <ui:NumberBox Value="{Binding PricePerTonRub, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SpinButtonPlacementMode="Compact"
                                          Minimum="0" SmallChange="10"
                                          HorizontalAlignment="Stretch" Padding="8,6"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock Text="Məzənnə (RUB→USD) *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <ui:NumberBox Value="{Binding HistoricalExchangeRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SpinButtonPlacementMode="Compact"
                                          Minimum="0.0001" SmallChange="0.001"
                                          HorizontalAlignment="Stretch" Padding="8,6"/>
                        </StackPanel>
                    </Grid>

                    <!-- Section: Nəqliyyat -->
                    <TextBlock Text="Nəqliyyat" FontSize="18" FontWeight="Bold" Margin="0,12,0,16" Foreground="#222"/>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Nəqliyyat Növü *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <ComboBox ItemsSource="{Binding TransportTypes}"
                                      SelectedItem="{Binding TransportType, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      FontSize="14" Padding="12,10"
                                      BorderBrush="#D1D1D1">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToUpperConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,10,0">
                            <TextBlock Text="Nəql. Valyutası" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <ComboBox ItemsSource="{Binding PaymentCurrencies}"
                                      SelectedItem="{Binding TransportCurrency, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      FontSize="14" Padding="12,10"
                                      BorderBrush="#D1D1D1">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToUpperConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="10,0,10,0">
                            <TextBlock Text="Vasitə Sayı" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <ui:NumberBox Value="{Binding VehicleCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SpinButtonPlacementMode="Compact"
                                          Minimum="1"
                                          HorizontalAlignment="Stretch" Padding="8,6"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="10,0,0,0">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Qiymət/Vasitə (USD)"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TransportCurrency}" Value="Rub">
                                                <Setter Property="Text" Value="Qiymət/Vasitə (RUB)"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ui:NumberBox Value="{Binding PricePerVehicle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SpinButtonPlacementMode="Compact"
                                          Minimum="0"
                                          HorizontalAlignment="Stretch" Padding="8,6"/>
                        </StackPanel>
                    </Grid>

                    <!-- Section: Əlavə Xərclər -->
                    <TextBlock Text="Əlavə Xərclər" FontSize="18" FontWeight="Bold" Margin="0,12,0,16" Foreground="#222"/>

                    <Border Background="#FFFBF0" CornerRadius="8" Padding="20" Margin="0,0,0,24"
                            BorderBrush="#FFE082" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Əlavə Xərc Valyutası" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                                    <ComboBox ItemsSource="{Binding PaymentCurrencies}"
                                              SelectedItem="{Binding AdditionalExpenseCurrency, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              FontSize="14" Padding="12,10"
                                              BorderBrush="#D1D1D1">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToUpperConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Əlavə Xərc Məbləği" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                                    <ui:NumberBox Value="{Binding AdditionalExpenseAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SpinButtonPlacementMode="Compact"
                                                  Minimum="0"
                                                  HorizontalAlignment="Stretch" Padding="8,6"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel>
                                <TextBlock Text="Əlavə Xərcin Təsviri" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                                <TextBox Text="{Binding AdditionalExpenseDescription, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="14" Padding="12,10" BorderBrush="#D1D1D1"
                                         TextWrapping="Wrap" MinHeight="50" AcceptsReturn="True"
                                         ui:ControlHelper.PlaceholderText="Məs: Gömrük rüsumu, sığorta xərci, anbar xərci..."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Section: Ton Başına Qazanc (İstifadəçi Gəliri) -->
                    <TextBlock Text="Ton Başına Qazanc" FontSize="18" FontWeight="Bold" Margin="0,12,0,16" Foreground="#222"/>

                    <Border Background="#F0FDF4" CornerRadius="8" Padding="20" Margin="0,0,0,24"
                            BorderBrush="#BBF7D0" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Ton Başı Qazanc *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#15803D"/>
                                    <ui:NumberBox Value="{Binding ProfitPerTon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SpinButtonPlacementMode="Compact"
                                                  Minimum="0"
                                                  HorizontalAlignment="Stretch" Padding="8,6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                    <TextBlock Text="Qazanc Valyutası" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#15803D"/>
                                    <ComboBox ItemsSource="{Binding PaymentCurrencies}"
                                              SelectedItem="{Binding ProfitPerTonCurrency, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              FontSize="14" Padding="12,10"
                                              BorderBrush="#D1D1D1">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToUpperConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Cəmi Qazancımız (USD)" FontSize="12" Foreground="#15803D" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding LiveUserProfitUsd, StringFormat='${0:N2}'}"
                                               FontSize="20" FontWeight="Bold" Foreground="#15803D"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="💡 Bu qazanc ümumi xərcin üzərinə əlavə olunaraq müştəriyə hesablanan yekun məbləği formalaşdırır."
                                       FontSize="12" Foreground="#166534" Opacity="0.85"/>
                        </StackPanel>
                    </Border>

                    <!-- Section: Ödəniş və Status -->
                    <TextBlock Text="Ödəniş və Status" FontSize="18" FontWeight="Bold" Margin="0,12,0,16" Foreground="#222"/>

                    <Border Background="#F9FAFB" CornerRadius="8" Padding="20" Margin="0,0,0,24"
                            BorderBrush="#E5E7EB" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Ödəniş Statusu *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#555"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton Grid.Column="0"
                                             Style="{StaticResource StatusCardRadioButtonStyle}"
                                             GroupName="PaymentStatusGroup"
                                             Content="💳 Ödənilib"
                                             Margin="0,0,8,0"
                                             IsChecked="{Binding PaymentStatus, Converter={StaticResource EnumEqualsToBoolConverter}, ConverterParameter=Paid, Mode=TwoWay}"/>

                                <RadioButton Grid.Column="1"
                                             Style="{StaticResource StatusCardRadioButtonStyle}"
                                             GroupName="PaymentStatusGroup"
                                             Content="⏳ Ödənilməyib"
                                             Margin="8,0,0,0"
                                             IsChecked="{Binding PaymentStatus, Converter={StaticResource EnumEqualsToBoolConverter}, ConverterParameter=Unpaid, Mode=TwoWay}"/>
                            </Grid>

                            <!-- Ödənilməyib Note Panel -->
                            <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1"
                                    CornerRadius="6" Padding="14,12" Margin="0,0,0,4"
                                    Visibility="{Binding PaymentStatus, Converter={StaticResource EnumEqualsToVisConverter}, ConverterParameter=Unpaid}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#BE123C" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Foreground="#BE123C" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap">
                                        <Run Text="Ödəniş hələ edilməyib. Ümumi hesablanan məbləğ ("/>
                                        <Run Text="{Binding LiveCustomerBilledUsd, StringFormat='${0:N2}', Mode=OneWay}" FontWeight="Bold"/>
                                        <Run Text=") müştərinin balansından borc olaraq çıxılacaq."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Ödənilib Inputs -->
                            <Grid Visibility="{Binding PaymentStatus, Converter={StaticResource EnumEqualsToVisConverter}, ConverterParameter=Paid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Ödəniş Valyutası" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                                    <ComboBox ItemsSource="{Binding PaymentCurrencies}"
                                              SelectedItem="{Binding PaidCurrency, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              FontSize="14" Padding="12,10"
                                              BorderBrush="#D1D1D1">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToUpperConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Ödənilən Məbləğ" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                                    <ui:NumberBox Value="{Binding PaidAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SpinButtonPlacementMode="Compact"
                                                  Minimum="0"
                                                  HorizontalAlignment="Stretch" Padding="8,6"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section: Göndərmə Statusu -->
                    <Grid Margin="0,12,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Göndərmə Statusu" FontSize="18" FontWeight="Bold" Foreground="#222" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Click="BtnOpenStatusDialog_Click"
                                Padding="12,6" Background="#F0F7FF" BorderBrush="#005FB8" BorderThickness="1"
                                Cursor="Hand" ToolTip="Status və tarixləri ayrıca pəncərədə tənzimlə">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7EC;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#005FB8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Pəncərədə Aç" FontSize="13" Foreground="#005FB8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Background="#F9FAFB" CornerRadius="8" Padding="20" Margin="0,0,0,24"
                            BorderBrush="#E5E7EB" BorderThickness="1">
                        <StackPanel>
                            <!-- STATUS CARDS (4 options - identical to update dialog) -->
                            <Grid Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Pending Card -->
                                <RadioButton Grid.Row="0" Grid.Column="0"
                                             Style="{StaticResource StatusCardRadioButtonStyle}"
                                             GroupName="EntryStatusGroup" Content="⏳ Gözləmədə"
                                             Margin="0,0,6,8"
                                             IsChecked="{Binding ShipmentStatus, Converter={StaticResource EnumEqualsToBoolConverter}, ConverterParameter=Pending, Mode=TwoWay}"/>

                                <!-- Loaded Card -->
                                <RadioButton Grid.Row="0" Grid.Column="1"
                                             Style="{StaticResource StatusCardRadioButtonStyle}"
                                             GroupName="EntryStatusGroup" Content="📦 Yükləndi"
                                             Margin="6,0,0,8"
                                             IsChecked="{Binding ShipmentStatus, Converter={StaticResource EnumEqualsToBoolConverter}, ConverterParameter=Loaded, Mode=TwoWay}"/>

                                <!-- InTransit Card -->
                                <RadioButton Grid.Row="1" Grid.Column="0"
                                             Style="{StaticResource StatusCardRadioButtonStyle}"
                                             GroupName="EntryStatusGroup" Content="🚚 Yoldadır"
                                             Margin="0,4,6,0"
                                             IsChecked="{Binding ShipmentStatus, Converter={StaticResource EnumEqualsToBoolConverter}, ConverterParameter=InTransit, Mode=TwoWay}"/>

                                <!-- Delivered Card -->
                                <RadioButton Grid.Row="1" Grid.Column="1"
                                             Style="{StaticResource StatusCardRadioButtonStyle}"
                                             GroupName="EntryStatusGroup" Content="🏁 Çatdı"
                                             Margin="6,4,0,0"
                                             IsChecked="{Binding ShipmentStatus, Converter={StaticResource EnumEqualsToBoolConverter}, ConverterParameter=Delivered, Mode=TwoWay}"/>
                            </Grid>

                            <!-- 1. PENDING PANEL (No dates required) -->
                            <Border Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1"
                                    CornerRadius="8" Padding="16,14"
                                    Visibility="{Binding ShipmentStatus, Converter={StaticResource EnumEqualsToVisConverter}, ConverterParameter=Pending}">
                                <TextBlock Text="Gözləmədə statusu üçün heç bir tarix tələb olunmur." Foreground="#777" FontSize="13"/>
                            </Border>

                            <!-- 2. LOADED PANEL (Stage 1) -->
                            <Border Background="#F0F7FF" BorderBrush="#BBDEFB" BorderThickness="1"
                                    CornerRadius="8" Padding="18"
                                    Visibility="{Binding ShipmentStatus, Converter={StaticResource EnumEqualsToVisConverter}, ConverterParameter=Loaded}">
                                <StackPanel>
                                    <TextBlock Text="Yüklənmə Tarixi" FontWeight="SemiBold" FontSize="13" Foreground="#1A237E" Margin="0,0,0,8"/>
                                    <DatePicker SelectedDate="{Binding LoadedDate, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch" Padding="8,6" BorderBrush="#D1D1D1"/>
                                </StackPanel>
                            </Border>

                            <!-- 3. IN-TRANSIT PANEL (Stage 2) -->
                            <Border Background="#F6F4FB" BorderBrush="#D1C4E9" BorderThickness="1"
                                    CornerRadius="8" Padding="18"
                                    Visibility="{Binding ShipmentStatus, Converter={StaticResource EnumEqualsToVisConverter}, ConverterParameter=InTransit}">
                                <StackPanel>
                                    <TextBlock Text="Yola Çıxma Tarixi" FontWeight="SemiBold" FontSize="13" Foreground="#4A148C" Margin="0,0,0,8"/>
                                    <DatePicker SelectedDate="{Binding InTransitStartDate, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch" Padding="8,6" Margin="0,0,0,14"/>

                                    <TextBlock Text="Yüklənmə Tarixi" FontWeight="SemiBold" FontSize="13" Foreground="#555" Margin="0,0,0,8"/>
                                    <DatePicker SelectedDate="{Binding LoadedDate, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch" Padding="8,6"/>
                                </StackPanel>
                            </Border>

                            <!-- 4. DELIVERED PANEL (Stage 3) -->
                            <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                                    CornerRadius="8" Padding="18"
                                    Visibility="{Binding ShipmentStatus, Converter={StaticResource EnumEqualsToVisConverter}, ConverterParameter=Delivered}">
                                <StackPanel>
                                    <TextBlock Text="Çatdırılma Tarixi" FontWeight="SemiBold" FontSize="13" Foreground="#1B5E20" Margin="0,0,0,8"/>
                                    <DatePicker SelectedDate="{Binding DeliveredDate, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch" Padding="8,6" Margin="0,0,0,14"/>

                                    <TextBlock Text="Yola Çıxma Tarixi" FontWeight="SemiBold" FontSize="13" Foreground="#555" Margin="0,0,0,8"/>
                                    <DatePicker SelectedDate="{Binding InTransitStartDate, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch" Padding="8,6" Margin="0,0,0,14"/>

                                    <TextBlock Text="Yüklənmə Tarixi" FontWeight="SemiBold" FontSize="13" Foreground="#555" Margin="0,0,0,8"/>
                                    <DatePicker SelectedDate="{Binding LoadedDate, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch" Padding="8,6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Section: Sənəd Yükləmə -->
                    <TextBlock Text="Sənəd" FontSize="18" FontWeight="Bold" Margin="0,12,0,16" Foreground="#222"/>

                    <Border Background="#F9F9F9" CornerRadius="8" Padding="20" Margin="0,0,0,32"
                            BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- File info -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock FontSize="13" Foreground="#555" Margin="0,0,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Heç bir sənəd seçilməyib"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDocument}" Value="True">
                                                    <Setter Property="Text" Value="{Binding DocumentFileName}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="PDF, JPG, PNG formatlarını dəstəkləyir" FontSize="11" Foreground="#999"
                                           Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}"/>
                            </StackPanel>

                            <!-- Upload / Clear buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Click="BtnUpload_Click" Padding="14,8" Margin="0,0,8,0"
                                        Background="#005FB8" Foreground="White" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Sənəd yüklə" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnClearFile_Click" Padding="10,8"
                                        Background="#FFEBEE" Foreground="#C62828" BorderThickness="0"
                                        Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisConverter}}"
                                        ToolTip="Sənədi sil">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid Margin="0,0,0,40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Click="BtnSave_Click"
                                Padding="32,14" Margin="0,0,12,0"
                                Background="#005FB8" Foreground="White" BorderThickness="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock FontSize="15" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Yadda Saxla"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                    <Setter Property="Text" Value="Yenilə"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Content="Formu Sıfırla" Click="BtnReset_Click"
                                Padding="24,14" Background="Transparent" Foreground="#666" BorderBrush="#D1D1D1"/>
                    </Grid>
                </StackPanel>

                <!-- RIGHT: LIVE SUMMARY PANEL -->
                <Border Grid.Column="1"
                        Background="#F8F9FA"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1" CornerRadius="12"
                        Padding="24" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="💰 Canlı Hesablama" FontSize="20" FontWeight="Bold" Margin="0,0,0,24" Foreground="#005FB8"/>

                        <!-- Məhsul Xərci -->
                        <TextBlock Text="MƏHSUL XƏRCİ" FontSize="11" Foreground="#888" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Qiymət (RUB)" FontSize="14" Foreground="#444"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold" Foreground="#222"
                                       Text="{Binding LiveGoodsCostRub, StringFormat='{}{0:N2} ₽'}"/>
                        </Grid>
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="Qiymət (USD)" FontSize="14" Foreground="#444"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Foreground="#005FB8"
                                       Text="{Binding LiveGoodsCostUsd, StringFormat='{}{0:N2} $'}"/>
                        </Grid>

                        <Separator Margin="0,0,0,20" Background="#E0E0E0"/>

                        <!-- Nəqliyyat Xərci -->
                        <TextBlock Text="NƏQLİYYAT XƏRCİ" FontSize="11" Foreground="#888" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="Qiymət (USD)" FontSize="14" Foreground="#444"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Foreground="#005FB8"
                                       Text="{Binding LiveTransportCostUsd, StringFormat='{}{0:N2} $'}"/>
                        </Grid>

                        <Separator Margin="0,0,0,20" Background="#E0E0E0"/>

                        <!-- Əlavə Xərclər -->
                        <TextBlock Text="ƏLAVƏ XƏRCLƏR" FontSize="11" Foreground="#888" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="Qiymət (USD)" FontSize="14" Foreground="#444"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Foreground="#E67E22"
                                       Text="{Binding LiveAdditionalExpenseUsd, StringFormat='{}{0:N2} $'}"/>
                        </Grid>

                        <Separator Margin="0,0,0,20" Background="#E0E0E0"/>

                        <!-- Ümumi Xərc -->
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="ÜMUMİ XƏRC" FontSize="14" FontWeight="Bold" Foreground="#444"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="16" FontWeight="ExtraBold" Foreground="#E65100"
                                       Text="{Binding LiveTotalExpenseUsd, StringFormat='{}{0:N2} $'}"/>
                        </Grid>

                        <!-- Şirkət Qazancı (Ton Başına) -->
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="ŞİRKƏT QAZANCI" FontSize="14" FontWeight="Bold" Foreground="#15803D"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="16" FontWeight="ExtraBold" Foreground="#15803D"
                                       Text="{Binding LiveUserProfitUsd, StringFormat='{}{0:N2} $'}"/>
                        </Grid>

                        <Separator Margin="0,0,0,16" Background="#E0E0E0"/>

                        <!-- Müştəriyə Hesablanan Məbləğ -->
                        <Grid Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="MÜŞTƏRİYƏ HESABLANAN" FontSize="13" FontWeight="Bold" Foreground="#1A237E"/>
                                <TextBlock Text="(Xərc + Qazanc)" FontSize="10" Foreground="#888"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" FontSize="18" FontWeight="ExtraBold" Foreground="#1A237E"
                                       Text="{Binding LiveCustomerBilledUsd, StringFormat='{}{0:N2} $'}"/>
                        </Grid>

                        <Separator Margin="0,0,0,20" Background="#E0E0E0"/>

                        <!-- Ödəniş Statusu və Məbləği -->
                        <TextBlock Text="ÖDƏNİŞ MƏLUMATI" FontSize="11" Foreground="#888" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Status" FontSize="14" Foreground="#444"/>
                            <Border HorizontalAlignment="Right" CornerRadius="4" Padding="6,2"
                                    Background="{Binding PaymentStatus, Converter={StaticResource PaymentStatusToBgConverter}}">
                                <TextBlock Text="{Binding PaymentStatus, Converter={StaticResource PaymentStatusToTextConverter}}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{Binding PaymentStatus, Converter={StaticResource PaymentStatusToFgConverter}}"/>
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,24">
                            <TextBlock Text="Faktiki Ödəniş (USD)" FontSize="14" Foreground="#444"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Foreground="#2E7D32"
                                       Text="{Binding LivePaidInUsd, StringFormat='{}{0:N2} $'}"/>
                        </Grid>

                        <!-- Müştəri Balansına Təsir (Balance Delta Card) -->
                        <Border CornerRadius="8" Padding="16,14" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Müştəri Balansına Təsiri"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#666"
                                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding DebtStatusText}"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,0,0,4"
                                           Foreground="{Binding DebtStatusColor}"/>
                                <TextBlock FontSize="28" FontWeight="ExtraBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding DebtStatusColor}"
                                           Text="{Binding LiveBalanceDeltaUsd, StringFormat='{}{0:+#,##0.00;-#,##0.00;0.00} $'}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"
                Background="#AAFFFFFF">
            <ui:ProgressRing IsActive="{Binding IsLoading}"
                             Width="48" Height="48"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Foreground="#005FB8"/>
        </Border>
    </Grid>
</UserControl>
