<UserControl x:Class="TableCreater.WPF.Views.Pages.TransactionEntryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:enums="clr-namespace:TableCreater.WPF.Enums"
             Focusable="True"
             KeyDown="UserControl_KeyDown">

    <Grid Background="White" MouseDown="BackgroundGrid_MouseDown">
        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" Padding="24,16"
                      PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Form Fields -->
                    <ColumnDefinition Width="*" MinWidth="480"/>
                    <!-- Live Summary Panel -->
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: TRANSACTION FORM -->
                <StackPanel Grid.Column="0" Margin="0,0,32,0">

                    <!-- Back Button -->
                    <Button Click="BtnBack_Click" Padding="10,6" Margin="0,0,0,16"
                            Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#005FB8"/>
                            <TextBlock Text="Geri qayıt" FontSize="13" Foreground="#005FB8" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Success Message -->
                    <Border Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisConverter}}"
                            Background="#E8F5E9" BorderBrush="#2E7D32" BorderThickness="1"
                            CornerRadius="6" Padding="16,12" Margin="0,0,0,20">
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="#2E7D32" FontSize="14" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Error Message -->
                    <Border Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisConverter}}"
                            Background="#FFEBEE" BorderBrush="#C62828" BorderThickness="1"
                            CornerRadius="6" Padding="16,12" Margin="0,0,0,20">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" FontSize="14" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Section: Müştəri və Tarix -->
                    <TextBlock Text="Müştəri və Tarix" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" Foreground="#222"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Müştəri Seçimi *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <ComboBox ItemsSource="{Binding Customers}"
                                      SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      IsEditable="True"
                                      Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Stretch"
                                      FontSize="14" Padding="12,10"
                                      BorderBrush="#D1D1D1"
                                      ui:ControlHelper.PlaceholderText="Müştəri axtar və ya seç..."/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Tranzaksiya Tarixi *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <DatePicker SelectedDate="{Binding TransactionDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        HorizontalAlignment="Stretch"
                                        Padding="8,6"
                                        BorderBrush="#D1D1D1"/>
                        </StackPanel>
                    </Grid>

                    <!-- Section: Məhsul Məlumatları -->
                    <TextBlock Text="Məhsul Məlumatları" FontSize="18" FontWeight="Bold" Margin="0,12,0,16" Foreground="#222"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Məhsulun Adı *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Padding="12,10" BorderBrush="#D1D1D1"
                                     ui:ControlHelper.PlaceholderText="Məs: Dəmir Filizi"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,10,0">
                            <TextBlock Text="Qəbul Edən Firma *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <TextBox Text="{Binding ReceivingCompany, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Padding="12,10" BorderBrush="#D1D1D1"
                                     ui:ControlHelper.PlaceholderText="Məs: ABC MMC"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock Text="Göndərən Firma" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <TextBox Text="{Binding SendingCompany, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Padding="12,10" BorderBrush="#D1D1D1"
                                     ui:ControlHelper.PlaceholderText="Məs: XYZ LLC"/>
                        </StackPanel>
                    </Grid>

                    <!-- Çəki, Qiymət və Məzənnə (3 columns) -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Çəki (Ton) *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <ui:NumberBox Value="{Binding WeightTon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SpinButtonPlacementMode="Compact"
                                          Minimum="0" SmallChange="0.1"
                                          HorizontalAlignment="Stretch" Padding="8,6"
                                          PlaceholderText="0.00"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="4,0,8,0">
                            <TextBlock Text="Qiymət/Ton (RUB) *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <ui:NumberBox Value="{Binding PricePerTonRub, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SpinButtonPlacementMode="Compact"
                                          Minimum="0" SmallChange="10"
                                          HorizontalAlignment="Stretch" Padding="8,6"
                                          PlaceholderText="0.00"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                            <TextBlock Text="Məzənnə (1$ = ? ₽) *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#0E7490"/>
                            <ui:NumberBox Value="{Binding ExchangeRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SpinButtonPlacementMode="Compact"
                                          Minimum="0.01" SmallChange="1"
                                          HorizontalAlignment="Stretch" Padding="8,6"
                                          PlaceholderText="90.00"/>
                        </StackPanel>
                    </Grid>

                    <!-- Section: Nəqliyyat -->
                    <TextBlock Text="Nəqliyyat" FontSize="18" FontWeight="Bold" Margin="0,12,0,16" Foreground="#222"/>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Nəqliyyat Növü *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <ComboBox ItemsSource="{Binding TransportTypes}"
                                      SelectedItem="{Binding TransportType, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      FontSize="14" Padding="12,10"
                                      BorderBrush="#D1D1D1">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource TransportTypeToTextConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,10,0">
                            <TextBlock Text="Nəql. Valyutası" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <ComboBox ItemsSource="{Binding PaymentCurrencies}"
                                      SelectedItem="{Binding TransportCurrency, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      FontSize="14" Padding="12,10"
                                      BorderBrush="#D1D1D1">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToUpperConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="10,0,10,0">
                            <TextBlock Text="Vasitə Sayı" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555"/>
                            <ui:NumberBox Value="{Binding VehicleCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SpinButtonPlacementMode="Compact"
                                          Minimum="1"
                                          HorizontalAlignment="Stretch" Padding="8,6"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="10,0,0,0">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#555">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Qiymət/Vasitə (USD)"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TransportCurrency}" Value="Rub">
                                                <Setter Property="Text" Value="Qiymət/Vasitə (RUB)"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ui:NumberBox Value="{Binding PricePerVehicle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SpinButtonPlacementMode="Compact"
                                          Minimum="0"
                                          HorizontalAlignment="Stretch" Padding="8,6"/>
                        </StackPanel>
                    </Grid>

                    <!-- Section: Dinamik Əlavə Xərclər (Per Ton) -->
                    <Grid Margin="0,12,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Əlavə Xərclər" FontSize="18" FontWeight="Bold" Foreground="#222"/>
                            <TextBlock Text="Ton başına və ya vahid (sabit) əlavə xərclər (gömrük, sığorta, anbar və s.)" FontSize="12" Foreground="#666" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding AddAdditionalExpenseCommand}"
                                Padding="14,8" Background="#F0F7FF" BorderBrush="#005FB8" BorderThickness="1"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#005FB8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Xərc Əlavə Et" FontSize="13" Foreground="#005FB8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Background="#FFFBF0" CornerRadius="8" Padding="16" Margin="0,0,0,24"
                            BorderBrush="#FFE082" BorderThickness="1">
                        <StackPanel>
                            <!-- Empty state notice when no expenses added -->
                            <TextBlock Text="Heç bir əlavə xərc əlavə edilməyib. Əlavə xərc (məs: gömrük, sığorta, anbar) üçün 'Xərc Əlavə Et' düyməsinə klikləyin."
                                       Foreground="#8C6D1F" FontSize="12" FontStyle="Italic" Margin="4,4,4,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AdditionalExpenses.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Additional Expense Items -->
                            <ItemsControl ItemsSource="{Binding AdditionalExpenses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                                CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="1.3*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Xərcin Adı -->
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="Xərcin Təsviri" FontSize="11" Foreground="#777" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="13" Padding="8,6" BorderBrush="#D1D1D1"
                                                             ui:ControlHelper.PlaceholderText="Məs: Gömrük rüsumu"/>
                                                </StackPanel>

                                                <!-- Hesablama Növü (Ton Başına / Vahid) -->
                                                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                                    <TextBlock Text="Hesab Növü" FontSize="11" Foreground="#777" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="2" HorizontalAlignment="Stretch">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Ton Başına Button -->
                                                            <Button Grid.Column="0" Command="{Binding SetPerTonCommand}"
                                                                    Padding="3,5" BorderThickness="0" Cursor="Hand" Margin="0,0,1,0">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        <Setter Property="FontSize" Value="11"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPerTon}" Value="True">
                                                                                <Setter Property="Background" Value="#0E7490"/>
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <TextBlock Text="⚖ Ton" HorizontalAlignment="Center" FontSize="11"/>
                                                            </Button>
                                                            <!-- Vahid Button -->
                                                            <Button Grid.Column="1" Command="{Binding SetFixedCommand}"
                                                                    Padding="3,5" BorderThickness="0" Cursor="Hand" Margin="1,0,0,0">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        <Setter Property="FontSize" Value="11"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsFixed}" Value="True">
                                                                                <Setter Property="Background" Value="#7C3AED"/>
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <TextBlock Text="📦 Vahid" HorizontalAlignment="Center" FontSize="11"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Məbləğ -->
                                                <StackPanel Grid.Column="2" Margin="4,0,8,0">
                                                    <TextBlock FontSize="11" Foreground="#777" FontWeight="SemiBold" Margin="0,0,0,4">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Ton Başına Məbləğ"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFixed}" Value="True">
                                                                        <Setter Property="Text" Value="Vahid Məbləğ"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ui:NumberBox Value="{Binding AmountPerTon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  SpinButtonPlacementMode="Compact"
                                                                  Minimum="0" SmallChange="1"
                                                                  HorizontalAlignment="Stretch" Padding="6,6"
                                                                  PlaceholderText="0.00"/>
                                                </StackPanel>

                                                <!-- Valyuta Seçimi (Segmented USD / RUB) -->
                                                <StackPanel Grid.Column="3" Margin="4,0,8,0">
                                                    <TextBlock Text="Valyuta" FontSize="11" Foreground="#777" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="2" HorizontalAlignment="Stretch">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- USD Button -->
                                                            <Button Grid.Column="0" Command="{Binding SetUsdCommand}"
                                                                    Padding="4,6" BorderThickness="0" Cursor="Hand" Margin="0,0,2,0">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        <Setter Property="FontSize" Value="12"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsUsd}" Value="True">
                                                                                <Setter Property="Background" Value="#2563EB"/>
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <TextBlock Text="$ USD" HorizontalAlignment="Center"/>
                                                            </Button>
                                                            <!-- RUB Button -->
                                                            <Button Grid.Column="1" Command="{Binding SetRubCommand}"
                                                                    Padding="4,6" BorderThickness="0" Cursor="Hand" Margin="2,0,0,0">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        <Setter Property="FontSize" Value="12"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRub}" Value="True">
                                                                                <Setter Property="Background" Value="#9333EA"/>
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <TextBlock Text="₽ RUB" HorizontalAlignment="Center"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Cəmi Məbləğ (Live) -->
                                                <StackPanel Grid.Column="4" Margin="4,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="11" Foreground="#777" FontWeight="SemiBold" Margin="0,0,0,4">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Cəmi (Çəki × Qiymət)"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFixed}" Value="True">
                                                                        <Setter Property="Text" Value="Cəmi (Sabit)"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Border Background="#FFF7ED" BorderBrush="#FFEDD5" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LiveTotalAmount, StringFormat='{}{0:N2}'}"
                                                                       FontSize="14" FontWeight="ExtraBold" Foreground="#EA580C"/>
                                                            <TextBlock Text="{Binding CurrencySymbol}"
                                                                       FontSize="14" FontWeight="Bold" Foreground="#EA580C" Margin="4,0,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Sil Düyməsi -->
                                                <Button Grid.Column="5"
                                                        Command="{Binding DataContext.RemoveAdditionalExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        VerticalAlignment="Bottom" Margin="4,0,0,0"
                                                        Padding="10,7" Background="#FFEBEE" Foreground="#C62828" BorderThickness="0"
                                                        Cursor="Hand" ToolTip="Xərci sil">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Bütün Əlavə Xərclərin Cəmi Xülasəsi (Real-Time) -->
                            <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AdditionalExpenses.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#C2410C" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Bütün Əlavə Xərclərin Cəmi:" FontWeight="Bold" FontSize="13" Foreground="#9A3412" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- USD Cəmi -->
                                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="USD Cəmi: " FontSize="12" Foreground="#1E40AF" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding LiveAdditionalExpensesUsd, StringFormat='${0:N2}'}" FontSize="13" FontWeight="ExtraBold" Foreground="#1D4ED8"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- RUB Cəmi -->
                                        <Border Background="#FAF5FF" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="RUB Cəmi: " FontSize="12" Foreground="#7E22CE" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding LiveAdditionalExpensesRub, StringFormat='{}{0:N2} ₽'}" FontSize="13" FontWeight="ExtraBold" Foreground="#9333EA"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Yekun Cəm USD (Məzənnə ilə) -->
                                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Yekun Cəm (USD): " FontSize="12" Foreground="#15803D" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding LiveAdditionalExpensesUnifiedUsd, StringFormat='${0:N2}'}" FontSize="13" FontWeight="ExtraBold" Foreground="#166534"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Section: Ton Başına Qazanc (İstifadəçi Gəliri) -->
                    <TextBlock Text="Ton Başına Qazanc" FontSize="18" FontWeight="Bold" Margin="0,12,0,16" Foreground="#222"/>

                    <Border Background="#F0FDF4" CornerRadius="8" Padding="20" Margin="0,0,0,24"
                            BorderBrush="#BBF7D0" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Ton Başı Qazanc *" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#15803D"/>
                                    <ui:NumberBox Value="{Binding ProfitPerTon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SpinButtonPlacementMode="Compact"
                                                  Minimum="0"
                                                  HorizontalAlignment="Stretch" Padding="8,6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                    <TextBlock Text="Qazanc Valyutası" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#15803D"/>
                                    <ComboBox ItemsSource="{Binding PaymentCurrencies}"
                                              SelectedItem="{Binding ProfitPerTonCurrency, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              FontSize="14" Padding="12,10"
                                              BorderBrush="#D1D1D1">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToUpperConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="12" Foreground="#15803D" FontWeight="SemiBold" Margin="0,0,0,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Cəmi Qazancımız (USD)"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProfitPerTonCurrency}" Value="Rub">
                                                        <Setter Property="Text" Value="Cəmi Qazancımız (RUB)"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="#15803D">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding LiveProfitUsd, StringFormat='${0:N2}'}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProfitPerTonCurrency}" Value="Rub">
                                                            <Setter Property="Text" Value="{Binding LiveProfitRub, StringFormat='{}{0:N2} ₽'}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="💡 Bu qazanc müvafiq valyuta üzrə ümumi məbləğə əlavə olunaraq müştərinin balansından çıxılacaq."
                                       FontSize="12" Foreground="#166534" Opacity="0.85"/>
                        </StackPanel>
                    </Border>

                    <!-- Section: Göndərmə Statusu -->
                    <Grid Margin="0,12,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Göndərmə Statusu" FontSize="18" FontWeight="Bold" Foreground="#222" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Click="BtnOpenStatusDialog_Click"
                                Padding="12,6" Background="#F0F7FF" BorderBrush="#005FB8" BorderThickness="1"
                                Cursor="Hand" ToolTip="Status və tarixləri ayrıca pəncərədə tənzimlə">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7EC;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#005FB8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Pəncərədə Aç" FontSize="13" Foreground="#005FB8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Background="#F9FAFB" CornerRadius="8" Padding="20" Margin="0,0,0,24"
                            BorderBrush="#E5E7EB" BorderThickness="1">
                        <StackPanel>
                            <!-- STATUS CARDS -->
                            <Grid Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Pending Card -->
                                <RadioButton Grid.Row="0" Grid.Column="0"
                                             Style="{StaticResource StatusCardRadioButtonStyle}"
                                             GroupName="EntryStatusGroup" Content="⏳ Gözləmədə"
                                             Margin="0,0,6,8"
                                             IsChecked="{Binding ShipmentStatus, Converter={StaticResource EnumEqualsToBoolConverter}, ConverterParameter=Pending, Mode=TwoWay}"/>

                                <!-- Loaded Card -->
                                <RadioButton Grid.Row="0" Grid.Column="1"
                                             Style="{StaticResource StatusCardRadioButtonStyle}"
                                             GroupName="EntryStatusGroup" Content="📦 Yükləndi"
                                             Margin="6,0,0,8"
                                             IsChecked="{Binding ShipmentStatus, Converter={StaticResource EnumEqualsToBoolConverter}, ConverterParameter=Loaded, Mode=TwoWay}"/>

                                <!-- InTransit Card -->
                                <RadioButton Grid.Row="1" Grid.Column="0"
                                             Style="{StaticResource StatusCardRadioButtonStyle}"
                                             GroupName="EntryStatusGroup" Content="🚚 Yoldadır"
                                             Margin="0,4,6,0"
                                             IsChecked="{Binding ShipmentStatus, Converter={StaticResource EnumEqualsToBoolConverter}, ConverterParameter=InTransit, Mode=TwoWay}"/>

                                <!-- Delivered Card -->
                                <RadioButton Grid.Row="1" Grid.Column="1"
                                             Style="{StaticResource StatusCardRadioButtonStyle}"
                                             GroupName="EntryStatusGroup" Content="🏁 Çatdı"
                                             Margin="6,4,0,0"
                                             IsChecked="{Binding ShipmentStatus, Converter={StaticResource EnumEqualsToBoolConverter}, ConverterParameter=Delivered, Mode=TwoWay}"/>
                            </Grid>

                            <!-- 1. PENDING PANEL -->
                            <Border Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1"
                                    CornerRadius="8" Padding="16,14"
                                    Visibility="{Binding ShipmentStatus, Converter={StaticResource EnumEqualsToVisConverter}, ConverterParameter=Pending}">
                                <TextBlock Text="Gözləmədə statusu üçün heç bir tarix tələb olunmur." Foreground="#777" FontSize="13"/>
                            </Border>

                            <!-- 2. LOADED PANEL (Stage 1) -->
                            <Border Background="#F0F7FF" BorderBrush="#BBDEFB" BorderThickness="1"
                                    CornerRadius="8" Padding="18"
                                    Visibility="{Binding ShipmentStatus, Converter={StaticResource EnumEqualsToVisConverter}, ConverterParameter=Loaded}">
                                <StackPanel>
                                    <TextBlock Text="Yüklənmə Tarixi" FontWeight="SemiBold" FontSize="13" Foreground="#1A237E" Margin="0,0,0,8"/>
                                    <DatePicker SelectedDate="{Binding LoadedDate, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch" Padding="8,6" BorderBrush="#D1D1D1"/>
                                </StackPanel>
                            </Border>

                            <!-- 3. IN-TRANSIT PANEL (Stage 2) -->
                            <Border Background="#F6F4FB" BorderBrush="#D1C4E9" BorderThickness="1"
                                    CornerRadius="8" Padding="18"
                                    Visibility="{Binding ShipmentStatus, Converter={StaticResource EnumEqualsToVisConverter}, ConverterParameter=InTransit}">
                                <StackPanel>
                                    <TextBlock Text="Yola Çıxma Tarixi" FontWeight="SemiBold" FontSize="13" Foreground="#4A148C" Margin="0,0,0,8"/>
                                    <DatePicker SelectedDate="{Binding InTransitStartDate, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch" Padding="8,6" Margin="0,0,0,14"/>

                                    <TextBlock Text="Yüklənmə Tarixi" FontWeight="SemiBold" FontSize="13" Foreground="#555" Margin="0,0,0,8"/>
                                    <DatePicker SelectedDate="{Binding LoadedDate, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch" Padding="8,6"/>
                                </StackPanel>
                            </Border>

                            <!-- 4. DELIVERED PANEL (Stage 3) -->
                            <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                                    CornerRadius="8" Padding="18"
                                    Visibility="{Binding ShipmentStatus, Converter={StaticResource EnumEqualsToVisConverter}, ConverterParameter=Delivered}">
                                <StackPanel>
                                    <TextBlock Text="Çatdırılma Tarixi" FontWeight="SemiBold" FontSize="13" Foreground="#1B5E20" Margin="0,0,0,8"/>
                                    <DatePicker SelectedDate="{Binding DeliveredDate, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch" Padding="8,6" Margin="0,0,0,14"/>

                                    <TextBlock Text="Yola Çıxma Tarixi" FontWeight="SemiBold" FontSize="13" Foreground="#555" Margin="0,0,0,8"/>
                                    <DatePicker SelectedDate="{Binding InTransitStartDate, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch" Padding="8,6" Margin="0,0,0,14"/>

                                    <TextBlock Text="Yüklənmə Tarixi" FontWeight="SemiBold" FontSize="13" Foreground="#555" Margin="0,0,0,8"/>
                                    <DatePicker SelectedDate="{Binding LoadedDate, Mode=TwoWay}"
                                                HorizontalAlignment="Stretch" Padding="8,6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Section: Sənəd Yükləmə -->
                    <TextBlock Text="Sənəd" FontSize="18" FontWeight="Bold" Margin="0,12,0,16" Foreground="#222"/>

                    <Border Background="#F9F9F9" CornerRadius="8" Padding="20" Margin="0,0,0,32"
                            BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock FontSize="13" Foreground="#555" Margin="0,0,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Heç bir sənəd seçilməyib"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDocument}" Value="True">
                                                    <Setter Property="Text" Value="{Binding DocumentFileName}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="PDF, JPG, PNG formatlarını dəstəkləyir" FontSize="11" Foreground="#999"
                                           Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Click="BtnUpload_Click" Padding="14,8" Margin="0,0,8,0"
                                        Background="#005FB8" Foreground="White" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Sənəd yüklə" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnClearFile_Click" Padding="10,8"
                                        Background="#FFEBEE" Foreground="#C62828" BorderThickness="0"
                                        Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisConverter}}"
                                        ToolTip="Sənədi sil">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid Margin="0,0,0,40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Click="BtnSave_Click"
                                Padding="32,14" Margin="0,0,12,0"
                                Background="#005FB8" Foreground="White" BorderThickness="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock FontSize="15" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Yadda Saxla"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                    <Setter Property="Text" Value="Yenilə"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Content="Formu Sıfırla" Click="BtnReset_Click"
                                Padding="24,14" Background="Transparent" Foreground="#666" BorderBrush="#D1D1D1"/>
                    </Grid>
                </StackPanel>

                <!-- RIGHT: LIVE SUMMARY PANEL (Dual-Stream Accounting) -->
                <Border Grid.Column="1"
                        Background="#F8FAFC"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1" CornerRadius="12"
                        Padding="20" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="💰 Hesablama və Balans" FontSize="18" FontWeight="Bold" Margin="0,0,0,18" Foreground="#0F172A"/>

                        <!-- ================= RUB KASSASI BÖLMƏSİ ================= -->
                        <Border Background="#FDF4FF" BorderBrush="#F0ABFC" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="₽" FontSize="16" FontWeight="Bold" Foreground="#A21CAF" Margin="0,0,6,0"/>
                                    <TextBlock Text="RUB KASSASI HESABLAŞMASI" FontSize="12" FontWeight="Bold" Foreground="#A21CAF" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Məhsul Xərci (RUB) -->
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Məhsul Dəyəri" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
                                               Text="{Binding LiveGoodsCostRub, StringFormat='{}{0:N2} ₽'}"/>
                                </Grid>

                                <!-- Nəqliyyat (RUB) -->
                                <Grid Margin="0,0,0,4" Visibility="{Binding LiveTransportCostRub, Converter={StaticResource NumericGreaterThanZeroToVisConverter}}">
                                    <TextBlock Text="Nəqliyyat" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
                                               Text="{Binding LiveTransportCostRub, StringFormat='{}{0:N2} ₽'}"/>
                                </Grid>

                                <!-- Əlavə Xərclər (RUB) -->
                                <Grid Margin="0,0,0,4" Visibility="{Binding LiveAdditionalExpensesRub, Converter={StaticResource NumericGreaterThanZeroToVisConverter}}">
                                    <TextBlock Text="Əlavə Xərclər" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
                                               Text="{Binding LiveAdditionalExpensesRub, StringFormat='{}{0:N2} ₽'}"/>
                                </Grid>

                                <!-- Qazanc (RUB) -->
                                <Grid Margin="0,0,0,8" Visibility="{Binding LiveProfitRub, Converter={StaticResource NumericGreaterThanZeroToVisConverter}}">
                                    <TextBlock Text="Şirkət Qazancı" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
                                               Text="{Binding LiveProfitRub, StringFormat='{}{0:N2} ₽'}"/>
                                </Grid>

                                <Separator Background="#E9D5FF" Margin="0,0,0,8"/>

                                <!-- Cəmi RUB Çıxılacaq -->
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Bu Tranzaksiya:" FontSize="13" FontWeight="Bold" Foreground="#701A75"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="15" FontWeight="ExtraBold" Foreground="#701A75"
                                               Text="{Binding LiveTotalBilledRub, StringFormat='-{0:N2} ₽'}"/>
                                </Grid>

                                <!-- Balans Dəyişimi -->
                                <Border Background="White" CornerRadius="6" Padding="10,8" BorderBrush="#E9D5FF" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Cari Balans" FontSize="10" Foreground="#888"/>
                                            <TextBlock Text="{Binding CustomerRubBalance, StringFormat='{}{0:N2} ₽'}" FontSize="12" FontWeight="Bold" Foreground="#444"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="➔" FontSize="14" Foreground="#A855F7" VerticalAlignment="Center" Margin="6,0"/>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="Sonrakı Balans" FontSize="10" Foreground="#888" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding LiveNewRubBalance, StringFormat='{}{0:N2} ₽'}" FontSize="13" FontWeight="ExtraBold" Foreground="#701A75" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ================= USD KASSASI BÖLMƏSİ ================= -->
                        <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="$" FontSize="16" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,0,6,0"/>
                                    <TextBlock Text="USD KASSASI HESABLAŞMASI" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Nəqliyyat (USD) -->
                                <Grid Margin="0,0,0,4" Visibility="{Binding LiveTransportCostUsd, Converter={StaticResource NumericGreaterThanZeroToVisConverter}}">
                                    <TextBlock Text="Nəqliyyat" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
                                               Text="{Binding LiveTransportCostUsd, StringFormat='${0:N2}'}"/>
                                </Grid>

                                <!-- Əlavə Xərclər (USD) -->
                                <Grid Margin="0,0,0,4" Visibility="{Binding LiveAdditionalExpensesUsd, Converter={StaticResource NumericGreaterThanZeroToVisConverter}}">
                                    <TextBlock Text="Əlavə Xərclər" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
                                               Text="{Binding LiveAdditionalExpensesUsd, StringFormat='${0:N2}'}"/>
                                </Grid>

                                <!-- Qazanc (USD) -->
                                <Grid Margin="0,0,0,8" Visibility="{Binding LiveProfitUsd, Converter={StaticResource NumericGreaterThanZeroToVisConverter}}">
                                    <TextBlock Text="Şirkət Qazancı" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
                                               Text="{Binding LiveProfitUsd, StringFormat='${0:N2}'}"/>
                                </Grid>

                                <Separator Background="#BFDBFE" Margin="0,0,0,8"/>

                                <!-- Cəmi USD Çıxılacaq -->
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Bu Tranzaksiya:" FontSize="13" FontWeight="Bold" Foreground="#1E3A8A"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="15" FontWeight="ExtraBold" Foreground="#1E3A8A"
                                               Text="{Binding LiveTotalBilledUsd, StringFormat='-${0:N2}'}"/>
                                </Grid>

                                <!-- Balans Dəyişimi -->
                                <Border Background="White" CornerRadius="6" Padding="10,8" BorderBrush="#BFDBFE" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Cari Balans" FontSize="10" Foreground="#888"/>
                                            <TextBlock Text="{Binding CustomerUsdBalance, StringFormat='${0:N2}'}" FontSize="12" FontWeight="Bold" Foreground="#444"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="➔" FontSize="14" Foreground="#3B82F6" VerticalAlignment="Center" Margin="6,0"/>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="Sonrakı Balans" FontSize="10" Foreground="#888" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding LiveNewUsdBalance, StringFormat='${0:N2}'}" FontSize="13" FontWeight="ExtraBold" Foreground="#1E3A8A" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ================= VAHİD HESABAT (USD EKVİVALENTİ) ================= -->
                        <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="🌐" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="VAHİD HESABAT (USD EKVİVALENTİ)" FontSize="12" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Məzənnə -->
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Məzənnə:" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
                                               Text="{Binding ExchangeRate, StringFormat='1 $ = {0:N2} ₽'}"/>
                                </Grid>

                                <!-- Maya Dəyəri (USD) -->
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Maya Dəyəri (USD):" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
                                               Text="{Binding LiveBaseCostUnifiedUsd, StringFormat='${0:N2}'}"/>
                                </Grid>

                                <!-- Şirkət Qazancı (USD) -->
                                <Grid Margin="0,0,0,8" Visibility="{Binding LiveProfitUnifiedUsd, Converter={StaticResource NumericGreaterThanZeroToVisConverter}}">
                                    <TextBlock Text="Şirkət Qazancı (USD):" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#15803D"
                                               Text="{Binding LiveProfitUnifiedUsd, StringFormat='${0:N2}'}"/>
                                </Grid>

                                <Separator Background="#BBF7D0" Margin="0,0,0,8"/>

                                <!-- Ümumi Xərc (Müştəri Hesabı USD) -->
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Ümumi Xərc (USD):" FontSize="13" FontWeight="Bold" Foreground="#166534"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="16" FontWeight="ExtraBold" Foreground="#166534"
                                               Text="{Binding LiveTotalExpenseUnifiedUsd, StringFormat='${0:N2}'}"/>
                                </Grid>
                                <TextBlock Text="RUB və USD xərclərinin məzənnə ilə toplanmış yekunu." FontSize="10.5" Foreground="#15803D"/>
                            </StackPanel>
                        </Border>

                        <!-- Note: Independent Cashboxes -->
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="10,8" BorderBrush="#E2E8F0" BorderThickness="1">
                            <TextBlock Text="💡 Qeyd: Hər kassa müstəqil hesablanır. Balans mənfiyə düşdükdə digər valyutaya təsir etmir."
                                       FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"
                Background="#AAFFFFFF">
            <ui:ProgressRing IsActive="{Binding IsLoading}"
                             Width="48" Height="48"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Foreground="#005FB8"/>
        </Border>
    </Grid>
</UserControl>
