<UserControl x:Class="TableCreater.WPF.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:TableCreater.WPF.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:DashboardViewModel}">

    <UserControl.Resources>
        <!-- KPI Card Base Style -->
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270"
                                      Color="#000000" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20" Background="#F8FAFC">
        <StackPanel MaxWidth="1200">

            <!-- PAGE HEADER -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#005FB8"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="İdarəetmə Paneli (Dashboard)" FontSize="26" FontWeight="Bold" Foreground="#1E293B"/>
                    </StackPanel>
                    <TextBlock Text="Biznesinizin cari vəziyyəti, açar göstəricilər və son əməliyyatların xülasəsi"
                               FontSize="13" Foreground="#64748B"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="BtnRefresh_Click"
                            ToolTip="Yenilə" Padding="12,8" Margin="0,0,8,0"
                            Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Yenilə" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="BtnNewTransaction_Click"
                            Style="{StaticResource AccentButtonStyle}" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Yeni Tranzaksiya" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- LOADING SPINNER -->
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>

            <!-- ERROR ALERT -->
            <Border Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisConverter}}"
                    Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1"
                    CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#DC2626"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 6 KPI CARDS GRID -->
            <Grid Margin="-4,0,-4,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD 1: Ümumi Müştəri -->
                <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Ümumi Müştəri" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                            <Border HorizontalAlignment="Right" Background="#EFF6FF" CornerRadius="6" Padding="6,4">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#2563EB"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding TotalCustomers}" FontSize="24" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="Qeydiyyatda olanlar" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- CARD 2: Aktiv Müştəri -->
                <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Aktiv Müştəri" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                            <Border HorizontalAlignment="Right" Background="#ECFDF5" CornerRadius="6" Padding="6,4">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#10B981"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding ActiveCustomers}" FontSize="24" FontWeight="Bold" Foreground="#047857"/>
                        <TextBlock Text="Aktiv statuslu" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- CARD 3: Bu Aykı Xərc -->
                <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Bu Aykı Xərc" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                            <Border HorizontalAlignment="Right" Background="#F5F3FF" CornerRadius="6" Padding="6,4">
                                <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#7C3AED"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding MonthlyExpenseUsd, StringFormat='${0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="#6D28D9"/>
                        <TextBlock Text="{Binding CurrentMonthName}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- CARD 4: Bu Aykı Ödəniş -->
                <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Bu Aykı Ödəniş" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                            <Border HorizontalAlignment="Right" Background="#ECFDF5" CornerRadius="6" Padding="6,4">
                                <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#059669"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding MonthlyPaidUsd, StringFormat='${0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="#059669"/>
                        <TextBlock Text="{Binding CurrentMonthName}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- CARD 5: Qazanc / Mənfəət -->
                <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Bu Aykı Qazanc" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                            <Border HorizontalAlignment="Right" Background="#F0FDF4" CornerRadius="6" Padding="6,4">
                                <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#16A34A"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding MonthlyProfitUsd, StringFormat='${0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="#15803D"/>
                        <TextBlock Text="{Binding MonthlyTransactionCount, StringFormat='{}{0} tranzaksiya'}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- CARD 6: Ümumi Balans -->
                <Border Grid.Column="5" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Ümumi Balans" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                            <Border HorizontalAlignment="Right" Background="#FFFBEB" CornerRadius="6" Padding="6,4">
                                <TextBlock Text="&#xE8C4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#D97706"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding TotalBalanceUsd, StringFormat='${0:N0}'}" FontSize="22" FontWeight="Bold"
                                   Foreground="{Binding TotalBalanceUsd, Converter={StaticResource ProfitLossToColorConverter}}"/>
                        <TextBlock Text="Sistem cəmi balans" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- TWO COLUMNS: RECENT TRANSACTIONS (70%) + DEBTORS / ALERTS (30%) -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="35*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: SON 10 TRANZAKSİYA -->
                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#005FB8"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Son 10 Tranzaksiya" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Click="BtnViewAllTransactions_Click"
                                    Background="Transparent" BorderThickness="0" Foreground="#005FB8" Cursor="Hand" Padding="0">
                                <TextBlock Text="Bütün Müştərilər →" FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>

                        <DataGrid ItemsSource="{Binding RecentTransactions}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  HeadersVisibility="Column"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  HorizontalScrollBarVisibility="Auto">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="8,10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="SeparatorVisibility" Value="Collapsed"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Height" Value="42"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <!-- ID -->
                                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="45">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Tarix -->
                                <DataGridTextColumn Header="Tarix" Binding="{Binding TransactionDate, StringFormat='yyyy-MM-dd'}" Width="85">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#334155"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontSize" Value="12"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Müştəri -->
                                <DataGridTextColumn Header="Müştəri" Binding="{Binding CustomerName}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#0F172A"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Məhsul -->
                                <DataGridTextColumn Header="Məhsul" Binding="{Binding ProductName}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#475569"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Çəki -->
                                <DataGridTextColumn Header="Çəki" Binding="{Binding WeightTonFormatted}" Width="75">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#475569"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Məbləğ USD -->
                                <DataGridTextColumn Header="Xərc (USD)" Binding="{Binding BilledUsdFormatted}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#0F172A"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Status Badge -->
                                <DataGridTemplateColumn Header="Status" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding PaymentStatus, Converter={StaticResource PaymentStatusToBgConverter}}"
                                                    CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PaymentStatusDisplay}"
                                                           Foreground="{Binding PaymentStatus, Converter={StaticResource PaymentStatusToFgConverter}}"
                                                           FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Actions -->
                                <DataGridTemplateColumn Header="Baxış" Width="55">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="BtnRowViewTransaction_Click" Tag="{Binding}"
                                                    ToolTip="Detallara bax"
                                                    Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand">
                                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#005FB8"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty state if no transactions -->
                        <Border Visibility="{Binding RecentTransactions.Count, Converter={StaticResource EnumEqualsToVisConverter}, ConverterParameter=0, FallbackValue=Collapsed}"
                                Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,10,0,0">
                            <TextBlock Text="Hələ heç bir tranzaksiya qeyd edilməyib." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- RIGHT: BORCLU / MƏNFİ BALANSLI MÜŞTƏRİLƏR -->
                <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#DC2626"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Borclu Müştərilər" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="#FEF2F2" CornerRadius="12" Padding="8,2">
                                <TextBlock Text="{Binding NegativeCustomers.Count, StringFormat='{}{0} nəfər'}"
                                           FontSize="11" FontWeight="Bold" Foreground="#DC2626"/>
                            </Border>
                        </Grid>

                        <!-- Empty State if no debtors -->
                        <Border Visibility="{Binding NegativeCustomers.Count, Converter={StaticResource EnumEqualsToVisConverter}, ConverterParameter=0, FallbackValue=Visible}"
                                Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                                CornerRadius="8" Padding="16" Margin="0,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#16A34A"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Hal-hazırda borclu müştəri yoxdur!" FontSize="13" Foreground="#15803D"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Debtors List -->
                        <ItemsControl ItemsSource="{Binding NegativeCustomers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="14,12" Margin="0,0,0,8"
                                            BorderBrush="#FEE2E2" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CustomerName}" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding LastTransactionDateFormatted, StringFormat='Son: {0}'}"
                                                           FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding BalanceFormatted}" FontSize="14" FontWeight="Bold" Foreground="#DC2626"/>
                                                <TextBlock Text="Borc" FontSize="10" Foreground="#EF4444" HorizontalAlignment="Right"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" Click="BtnViewDebtorCustomer_Click" Tag="{Binding}"
                                                    ToolTip="Müştəri kartına keç" VerticalAlignment="Center"
                                                    Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                                    ui:ControlHelper.CornerRadius="6" Padding="8,6" Cursor="Hand">
                                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#005FB8"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
