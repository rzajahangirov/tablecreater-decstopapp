<UserControl x:Class="TableCreater.WPF.Views.Pages.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:enums="clr-namespace:TableCreater.WPF.Enums">

    <UserControl.Resources>
        <!-- Quick Preset Button Style -->
        <Style x:Key="PresetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20" Background="#F8FAFC">
        <StackPanel MaxWidth="1100">

            <!-- PAGE HEADER -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#005FB8"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Maliyyə Hesabatları" FontSize="26" FontWeight="Bold" Foreground="#1E293B"/>
                    </StackPanel>
                    <TextBlock Text="Tarix aralığı və müştəri üzrə ümumi xərc, xərc+qazanc, ödəniş və gəlir analitikası"
                               FontSize="13" Foreground="#64748B"/>
                </StackPanel>
            </Grid>

            <!-- MESSAGES -->
            <Border Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisConverter}}"
                    Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1"
                    CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#059669"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#065F46" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisConverter}}"
                    Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1"
                    CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#DC2626"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- REPORT GENERATOR CARDS -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD 1: DATE RANGE REPORT -->
                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="22" Margin="0,0,10,0"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#0284C7"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Tarix Aralığı üzrə Hesabat" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>

                        <!-- Quick Presets -->
                        <TextBlock Text="Sürətli Seçim:" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,14">
                            <Button Content="Bu Gün" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetTodayCommand}"/>
                            <Button Content="Bu Həftə" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetThisWeekCommand}"/>
                            <Button Content="Bu Ay" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetThisMonthCommand}"/>
                            <Button Content="Keçən Ay" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetLastMonthCommand}"/>
                            <Button Content="Bu İl" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetThisYearCommand}"/>
                            <Button Content="Keçən İl" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetLastYearCommand}"/>
                            <Button Content="Bütün Zamanlar" Style="{StaticResource PresetButtonStyle}" Command="{Binding SetAllTimeCommand}"/>
                        </WrapPanel>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Başlanğıc Tarixi" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" HorizontalAlignment="Stretch" BorderBrush="#CBD5E1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Son Tarix" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" HorizontalAlignment="Stretch" BorderBrush="#CBD5E1"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="Hesabatı Göstər" Click="BtnDateRangeReport_Click"
                                Padding="0,11" Background="#0284C7" Foreground="White" BorderThickness="0"
                                HorizontalAlignment="Stretch" FontWeight="Bold" FontSize="14" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- CARD 2: CUSTOMER REPORT + EXPORT -->
                <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="22" Margin="10,0,0,0"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#4F46E5"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Müştəri üzrə Hesabat" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Müştəri Seçin" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding Customers}"
                                      SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                      DisplayMemberPath="Name" IsEditable="True"
                                      HorizontalAlignment="Stretch" FontSize="14" Padding="12,9"
                                      BorderBrush="#CBD5E1"
                                      ui:ControlHelper.PlaceholderText="Müştəri axtarın və ya seçin..."/>
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Hesabatı Göstər" Click="BtnCustomerReport_Click"
                                    Margin="0,0,6,0" Padding="0,11" Background="#4F46E5" Foreground="White" BorderThickness="0"
                                    FontWeight="Bold" FontSize="14" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Grid.Column="1" Content="Excel Export" Click="BtnExportExcel_Click"
                                    Margin="6,0,0,0" Padding="0,11" Background="#107C41" Foreground="White" BorderThickness="0"
                                    FontWeight="Bold" FontSize="14" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <Button Content="📊 Bütün Müştərilərin Xülasəsi (Ümumi Hesabat)" Click="BtnAllCustomersSummary_Click"
                                Padding="0,10" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                FontWeight="SemiBold" FontSize="13" Cursor="Hand" HorizontalAlignment="Stretch">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ALL CUSTOMERS SUMMARY TABLE (Task 7.2) -->
            <Border Visibility="{Binding IsAllCustomersSummaryView, Converter={StaticResource BoolToVisConverter}}"
                    Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,28"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#005FB8"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Bütün Müştərilər Üzrə Ümumi Maliyyə Xülasəsi" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="#EFF6FF" CornerRadius="12" Padding="10,4">
                            <TextBlock Text="{Binding AllCustomersSummary.Count, StringFormat='{}{0} müştəri'}"
                                       FontSize="12" FontWeight="Bold" Foreground="#2563EB"/>
                        </Border>
                    </Grid>

                    <DataGrid ItemsSource="{Binding AllCustomersSummary}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              BorderThickness="0">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="SeparatorVisibility" Value="Collapsed"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Height" Value="42"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Müştəri" Binding="{Binding CustomerName}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Tranzaksiya" Binding="{Binding TransactionCount}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Ümumi Xərc (USD)" Binding="{Binding TotalExpenseFormatted}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#E65100"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Ümumi Ödəniş (USD)" Binding="{Binding TotalPaidFormatted}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#059669"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Qazanc (USD)" Binding="{Binding TotalProfitFormatted}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#15803D"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Cari Balans (USD)" Binding="{Binding BalanceFormatted}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{Binding BalanceUsd, Converter={StaticResource ProfitLossToColorConverter}}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- RESULTS DASHBOARD -->
            <Border Visibility="{Binding HasReport, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,28">
                <StackPanel>

                    <!-- REPORT TITLE & METRICS BAR -->
                    <Border Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,0,16"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ReportTypeTitle}" FontSize="18" FontWeight="ExtraBold" Foreground="#0F172A"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>

                                <!-- Status Badges -->
                                <Border Background="#EEF2FF" CornerRadius="12" Padding="10,4" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding TransactionCount, StringFormat='Cəmi: {0} ədəd'}"
                                               FontSize="11" FontWeight="Bold" Foreground="#4338CA"/>
                                </Border>
                                <Border Background="#ECFDF5" CornerRadius="12" Padding="10,4" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding PaidTransactionCount, StringFormat='💳 Ödənilib: {0}'}"
                                               FontSize="11" FontWeight="Bold" Foreground="#059669"/>
                                </Border>
                                <Border Background="#FEF2F2" CornerRadius="12" Padding="10,4" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding UnpaidTransactionCount, StringFormat='⏳ Ödənilməyib: {0}'}"
                                               FontSize="11" FontWeight="Bold" Foreground="#DC2626"/>
                                </Border>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding TotalWeightTon, StringFormat='⚖️ {0:N2} Ton'}"
                                               FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                </Border>
                            </StackPanel>

                            <!-- Export Report Button -->
                            <Button Grid.Column="1" Click="BtnExportReportExcel_Click"
                                    Background="#107C41" Foreground="White" BorderThickness="0"
                                    Padding="14,8" FontWeight="Bold" FontSize="12" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE78C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Bu Hesabatı Excel-ə İxrac Et" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 6 FINANCIAL CARDS GRID -->
                    <Grid Margin="0,0,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Xərc + Qazanc (Müştəri Hesabı) -->
                        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,6,12" Padding="16,14"
                                Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1.5" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Xərc + Qazanc (Müştəri Hesabı)" FontSize="11" Foreground="#4338CA" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding TotalBilledUsd, StringFormat='${0:N2}'}" FontSize="22" FontWeight="ExtraBold" Foreground="#1E1B4B"/>
                                <TextBlock Text="Müştərilərə hesablanmış yekun məbləğ" FontSize="10.5" Foreground="#6366F1" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Ümumi Xərc -->
                        <Border Grid.Row="0" Grid.Column="1" Margin="3,0,3,12" Padding="16,14"
                                Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1.5" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Ümumi Xərc (Maya Dəyəri)" FontSize="11" Foreground="#D97706" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding TotalExpenseUsd, StringFormat='${0:N2}'}" FontSize="22" FontWeight="ExtraBold" Foreground="#B45309"/>
                                <TextBlock Text="Məhsul, daşıma və əlavə xərclər cəmi" FontSize="10.5" Foreground="#B45309" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Şirkət Qazancı (Mənfəət) -->
                        <Border Grid.Row="0" Grid.Column="2" Margin="6,0,0,12" Padding="16,14"
                                Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1.5" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Şirkət Qazancı (Mənfəət)" FontSize="11" Foreground="#15803D" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding TotalUserProfitUsd, StringFormat='${0:N2}'}" FontSize="22" FontWeight="ExtraBold" Foreground="#166534"/>
                                <TextBlock Text="{Binding ProfitMarginPercent, StringFormat='Gəlir marjası: {0}%'}" FontSize="10.5" Foreground="#15803D" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Ümumi Ödəniş -->
                        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,6,0" Padding="16,14"
                                Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1.5" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Ümumi Ödəniş (Yığılmış)" FontSize="11" Foreground="#047857" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding TotalPaidUsd, StringFormat='${0:N2}'}" FontSize="22" FontWeight="ExtraBold" Foreground="#065F46"/>
                                <TextBlock Text="{Binding CollectionRatePercent, StringFormat='Yığım dərəcəsi: {0}%'}" FontSize="10.5" Foreground="#047857" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 5: Qalıq Fərq / Borc -->
                        <Border Grid.Row="1" Grid.Column="1" Margin="3,0,3,0" Padding="16,14"
                                Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{Binding DebtStatusText}" FontSize="11" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding TotalBenefitUsd, StringFormat='${0:N2}'}" FontSize="22" FontWeight="ExtraBold"
                                           Foreground="{Binding DebtStatusColor}"/>
                                <TextBlock Text="Faktiki Ödəniş − Xərc+Qazanc" FontSize="10.5" Foreground="#94A3B8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 6: Kassa Fərqi (Nağd Pul Axını) -->
                        <Border Grid.Row="1" Grid.Column="2" Margin="6,0,0,0" Padding="16,14"
                                Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1.5" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{Binding BenefitStatusText}" FontSize="11" Foreground="#0369A1" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding TotalCashFlowUsd, StringFormat='${0:N2}'}" FontSize="22" FontWeight="ExtraBold"
                                           Foreground="{Binding BenefitStatusColor}"/>
                                <TextBlock Text="Faktiki Ödəniş − Birbaşa Xərc" FontSize="10.5" Foreground="#0284C7" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- DETAILED TRANSACTIONS BREAKDOWN -->
                    <Border Background="White" CornerRadius="10" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>

                            <!-- Breakdown Toolbar -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📋 Hesabata Daxil Olan Tranzaksiyalar" FontSize="15" FontWeight="Bold" Foreground="#1E293B"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding ReportFilteredCount, StringFormat='({0} tranzaksiya)'}"
                                               FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Search Box -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                                    <TextBox Text="{Binding ReportSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Width="240" FontSize="12" Padding="10,6" BorderBrush="#CBD5E1"
                                             ui:ControlHelper.PlaceholderText="Məhsul, şirkət və ya müştəri axtar..."/>
                                </StackPanel>

                                <!-- Payment Filter -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <ComboBox SelectedValue="{Binding ReportPaymentStatusFilter, Mode=TwoWay}"
                                              SelectedValuePath="Tag" Width="150" FontSize="12" Padding="8,6" BorderBrush="#CBD5E1">
                                        <ComboBoxItem Content="Bütün Ödənişlər" IsSelected="True"/>
                                        <ComboBoxItem Content="💳 Ödənilib" Tag="{x:Static enums:PaymentStatus.Paid}"/>
                                        <ComboBoxItem Content="⏳ Ödənilməyib" Tag="{x:Static enums:PaymentStatus.Unpaid}"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Transactions DataGrid -->
                            <DataGrid ItemsSource="{Binding ReportTransactions}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserSortColumns="True"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      BorderThickness="1"
                                      BorderBrush="#E2E8F0"
                                      RowHeight="36"
                                      FontSize="12"
                                      MaxHeight="400"
                                      Background="White">

                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        <Setter Property="SeparatorVisibility" Value="Collapsed"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Height" Value="36"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50"/>
                                    <DataGridTextColumn Header="Tarix" Binding="{Binding TransactionDate, StringFormat='dd.MM.yyyy'}" Width="85"/>
                                    <DataGridTextColumn Header="Müştəri" Binding="{Binding CustomerName}" Width="130"/>
                                    <DataGridTextColumn Header="Məhsul" Binding="{Binding ProductName}" Width="120"/>
                                    <DataGridTextColumn Header="Çəki" Binding="{Binding WeightTonFormatted}" Width="80"/>
                                    <DataGridTextColumn Header="Ümumi Xərc" Binding="{Binding HistoricalTotalExpenseUsd, StringFormat='${0:N2}'}" Width="105"/>
                                    <DataGridTextColumn Header="Şirkət Qazancı" Binding="{Binding HistoricalUserProfitUsd, StringFormat='${0:N2}'}" Width="105"/>
                                    <DataGridTextColumn Header="Xərc + Qazanc" Binding="{Binding HistoricalCustomerBilledUsd, StringFormat='${0:N2}'}" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#1E1B4B"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Padding" Value="6,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Ödəniş" Binding="{Binding PaidInUsd, StringFormat='${0:N2}'}" Width="95"/>

                                    <!-- Ödəniş Statusu Badge -->
                                    <DataGridTemplateColumn Header="Ödəniş Statusu" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding PaymentStatus, Converter={StaticResource PaymentStatusToBgConverter}}"
                                                        CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PaymentStatus, Converter={StaticResource PaymentStatusToTextConverter}}"
                                                               Foreground="{Binding PaymentStatus, Converter={StaticResource PaymentStatusToFgConverter}}"
                                                               FontSize="10.5" FontWeight="Bold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Göndərmə Statusu Badge -->
                                    <DataGridTemplateColumn Header="Yük Statusu" Width="95">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding ShipmentStatus, Converter={StaticResource ShipmentStatusToBgConverter}}"
                                                        CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ShipmentStatus, Converter={StaticResource ShipmentStatusToTextConverter}}"
                                                               Foreground="{Binding ShipmentStatus, Converter={StaticResource ShipmentStatusToFgConverter}}"
                                                               FontSize="10.5" FontWeight="Bold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <ui:ProgressRing IsActive="{Binding IsLoading}" Width="48" Height="48"
                             HorizontalAlignment="Center" Margin="0,20" Foreground="#005FB8"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
