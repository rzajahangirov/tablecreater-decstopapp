<Window x:Class="TableCreater.WPF.Views.Dialogs.BalanceHistoryExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Balans Tarixçəsi Excel İxracı"
        Width="920" Height="740"
        MinHeight="580" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F8FAFC">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Stepper -->
            <RowDefinition Height="*"/>     <!-- Step Content -->
            <RowDefinition Height="Auto"/>  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER (Excel Green Brand) -->
        <Border Grid.Row="0" Background="#107C41" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="40" Height="40" Background="#1E8E4F" CornerRadius="8" Margin="0,0,14,0"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="Balans Tarixçəsi — Əməliyyat Seçimi" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="TxtSubtitle" Text="" FontSize="12" Foreground="#D1FAE5" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. STEPPER INDICATOR -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="30,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Step 1 Indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border x:Name="Step1Circle" Width="30" Height="30" CornerRadius="15" 
                            Background="#107C41" Margin="0,0,10,0">
                        <TextBlock Text="1" FontSize="14" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="Step1Label" Text="Əməliyyat Seçimi" FontSize="13" FontWeight="Bold" Foreground="#107C41"/>
                        <TextBlock Text="Hansı əməliyyatları ixrac etmək istəyirsiniz?" FontSize="10" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Connector Line -->
                <Border Grid.Column="1" Width="60" Height="2" Background="#E2E8F0" VerticalAlignment="Center" Margin="10,0"
                        x:Name="StepConnector"/>

                <!-- Step 2 Indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border x:Name="Step2Circle" Width="30" Height="30" CornerRadius="15" 
                            Background="#E2E8F0" Margin="0,0,10,0">
                        <TextBlock x:Name="Step2Number" Text="2" FontSize="14" FontWeight="Bold" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="Step2Label" Text="Sütun Seçimi" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8"/>
                        <TextBlock Text="Excel-ə hansı sütunları daxil etmək istəyirsiniz?" FontSize="10" Foreground="#CBD5E1"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. STEP CONTENT AREA -->
        <Grid Grid.Row="2">

            <!-- ════════════ STEP 1: History Selection ════════════ -->
            <Grid x:Name="PanelStep1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Quick Actions -->
                    <RowDefinition Height="*"/>     <!-- DataGrid -->
                    <RowDefinition Height="Auto"/>  <!-- Summary -->
                </Grid.RowDefinitions>

                <!-- Quick Action Buttons -->
                <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="18,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Click="BtnSelectAll_Click"
                                Padding="10,5" Background="#F1F5F9" Foreground="#1E293B" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#107C41"/>
                                <TextBlock Text="Hamısını Seç" FontWeight="SemiBold" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Click="BtnDeselectAll_Click"
                                Padding="10,5" Background="#F1F5F9" Foreground="#1E293B" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#C62828"/>
                                <TextBlock Text="Seçimi Təmizlə" FontWeight="SemiBold" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Click="BtnInvertSelection_Click"
                                Padding="10,5" Background="#F1F5F9" Foreground="#1E293B" BorderThickness="0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#4338CA"/>
                                <TextBlock Text="Seçimi Tərsinə Çevir" FontWeight="SemiBold" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <!-- Selection Counter -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Seçilmiş: " FontSize="13" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtSelectedCount" Text="0" FontSize="14" FontWeight="Bold" Foreground="#107C41"/>
                            <TextBlock x:Name="TxtTotalCount" Text=" / 0" FontSize="13" Foreground="#64748B"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- History Selection DataGrid -->
                <DataGrid Grid.Row="1" x:Name="HistorySelectionGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          BorderThickness="0"
                          FontSize="12"
                          RowHeight="36"
                          ColumnHeaderHeight="34"
                          Background="White">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- Checkbox -->
                        <DataGridTemplateColumn Width="46" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelectedForExport, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Click="HistoryCheckBox_Changed"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Tarix -->
                        <DataGridTextColumn Header="Tarix" Binding="{Binding History.CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="125" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Kassa -->
                        <DataGridTemplateColumn Header="Kassa" Width="105" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E0F2FE"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding History.Currency}" Value="Rub">
                                                        <Setter Property="Background" Value="#F3E8FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding History.KassaName}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#0369A1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding History.Currency}" Value="Rub">
                                                            <Setter Property="Foreground" Value="#7E22CE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Əməliyyat Növü -->
                        <DataGridTemplateColumn Header="Əməliyyat Növü" Width="140" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding History.Type, Converter={StaticResource BalanceTypeToTextConverter}}"
                                               Foreground="{Binding History.Type, Converter={StaticResource BalanceTypeToColorConverter}}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Məbləğ -->
                        <DataGridTextColumn Header="Dəyişiklik" Binding="{Binding History.FormattedAmount}" Width="110" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#1E293B"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Yekun Balans -->
                        <DataGridTextColumn Header="Yekun Balans" Binding="{Binding History.FormattedBalanceAfter}" Width="110" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Qeyd / Təsvir -->
                        <DataGridTextColumn Header="Təsvir / Qeyd" Binding="{Binding History.Description}" Width="*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Summary Bar -->
                <Border Grid.Row="2" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="0,1,0,0" Padding="18,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Excel-ə daxil etmək istədiyiniz əməliyyatları işarələyin." FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>

                        <CheckBox Grid.Column="1" x:Name="ChkAutoOpen" Content="İxracdan sonra faylı aç" IsChecked="True"
                                  FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ════════════ STEP 2: Column Selection ════════════ -->
            <Grid x:Name="PanelStep2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Actions Toolbar -->
                    <RowDefinition Height="*"/>     <!-- Category Cards -->
                </Grid.RowDefinitions>

                <!-- Actions Toolbar -->
                <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="18,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Click="BtnSelectAllCols_Click"
                                Padding="10,5" Background="#F1F5F9" Foreground="#1E293B" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#107C41"/>
                                <TextBlock Text="Hamısını Seç" FontWeight="SemiBold" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Click="BtnDeselectAllCols_Click"
                                Padding="10,5" Background="#F1F5F9" Foreground="#1E293B" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#C62828"/>
                                <TextBlock Text="Seçimi Təmizlə" FontWeight="SemiBold" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Click="BtnResetDefaultCols_Click"
                                Padding="10,5" Background="#F1F5F9" Foreground="#1E293B" BorderThickness="0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#D97706"/>
                                <TextBlock Text="Standart Sütunlar" FontWeight="SemiBold" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Seçilmiş sütunlar: " FontSize="13" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtSelectedColCount" Text="0 / 0" FontSize="14" FontWeight="Bold" Foreground="#107C41"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Scrollable Category Cards -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <StackPanel x:Name="PanelCategories">
                        <!-- Dynamically populated in code-behind -->
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 4. FOOTER BUTTONS -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Error Text -->
                <TextBlock Grid.Column="0" x:Name="TxtError" Text="" Foreground="#C62828" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <!-- Cancel -->
                <Button Grid.Column="2" Content="İmtina" Click="BtnCancel_Click"
                        Padding="16,8" Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>

                <!-- Back (only visible on Step 2) -->
                <Button Grid.Column="3" x:Name="BtnBack" Click="BtnBack_Click" Visibility="Collapsed"
                        Padding="16,8" Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Geri" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                </Button>

                <!-- Next / Export -->
                <Button Grid.Column="4" x:Name="BtnNextExport" Click="BtnNextExport_Click"
                        Padding="20,8" Background="#107C41" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <StackPanel x:Name="BtnNextContent" Orientation="Horizontal">
                        <TextBlock x:Name="BtnNextText" Text="Davam Et — Sütun Seçimi" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
