<Window x:Class="TableCreater.WPF.Views.Dialogs.ShipmentStatusDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:enums="clr-namespace:TableCreater.WPF.Enums"
        Title="Göndərmə Statusunu Yenilə"
        Width="520" Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F8F9FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Footer Buttons -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#005FB8" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="40" Height="40" Background="#1A73E8" CornerRadius="20" Margin="0,0,14,0"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7EC;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Göndərmə Statusu" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="TxtTransactionSummary" Text="Müştəri / Məhsul / Tarix" FontSize="12" Foreground="#D0E2FF" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel>

                <!-- Error Message -->
                <Border x:Name="BorderError" Visibility="Collapsed" Background="#FFEBEE" BorderBrush="#C62828" BorderThickness="1"
                        CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                    <TextBlock x:Name="TxtError" Foreground="#C62828" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>

                <!-- STATUS CARDS (4 options) -->
                <Grid Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Pending Card -->
                    <RadioButton Grid.Row="0" Grid.Column="0" x:Name="RbPending"
                                 Style="{StaticResource StatusCardRadioButtonStyle}"
                                 GroupName="StatusGroup" Content="⏳ Gözləmədə"
                                 Margin="0,0,6,8" Checked="StatusRadioButton_Checked"/>

                    <!-- Loaded Card -->
                    <RadioButton Grid.Row="0" Grid.Column="1" x:Name="RbLoaded"
                                 Style="{StaticResource StatusCardRadioButtonStyle}"
                                 GroupName="StatusGroup" Content="📦 Yükləndi"
                                 Margin="6,0,0,8" Checked="StatusRadioButton_Checked"/>

                    <!-- InTransit Card -->
                    <RadioButton Grid.Row="1" Grid.Column="0" x:Name="RbInTransit"
                                 Style="{StaticResource StatusCardRadioButtonStyle}"
                                 GroupName="StatusGroup" Content="🚚 Yoldadır"
                                 Margin="0,4,6,0" Checked="StatusRadioButton_Checked"/>

                    <!-- Delivered Card -->
                    <RadioButton Grid.Row="1" Grid.Column="1" x:Name="RbDelivered"
                                 Style="{StaticResource StatusCardRadioButtonStyle}"
                                 GroupName="StatusGroup" Content="🏁 Çatdı"
                                 Margin="6,4,0,0" Checked="StatusRadioButton_Checked"/>
                </Grid>

                <Separator Margin="0,0,0,20" Background="#E0E0E0"/>

                <!-- 1. PENDING PANEL (No dates) -->
                <Border x:Name="PanelPending" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1"
                        CornerRadius="8" Padding="18" Margin="0,0,0,16" Visibility="Collapsed">
                    <TextBlock Text="Gözləmədə statusu üçün heç bir tarix tələb olunmur." Foreground="#777" FontSize="13"/>
                </Border>

                <!-- 2. LOADED PANEL (Stage 1) -->
                <Border x:Name="PanelLoaded" Background="#F0F7FF" BorderBrush="#BBDEFB" BorderThickness="1"
                        CornerRadius="8" Padding="18" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Yüklənmə Tarixi" FontWeight="SemiBold" FontSize="13" Foreground="#1A237E" Margin="0,0,0,8"/>
                        <DatePicker x:Name="DpLoadedDate" HorizontalAlignment="Stretch" Padding="8,6" BorderBrush="#D1D1D1"/>
                    </StackPanel>
                </Border>

                <!-- 3. IN-TRANSIT PANEL (Stage 2) -->
                <Border x:Name="PanelInTransit" Background="#F6F4FB" BorderBrush="#D1C4E9" BorderThickness="1"
                        CornerRadius="8" Padding="18" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Yola Çıxma Tarixi" FontWeight="SemiBold" FontSize="13" Foreground="#4A148C" Margin="0,0,0,8"/>
                        <DatePicker x:Name="DpInTransitStart" HorizontalAlignment="Stretch" Padding="8,6" Margin="0,0,0,14"/>

                        <TextBlock Text="Yüklənmə Tarixi" FontWeight="SemiBold" FontSize="13" Foreground="#555" Margin="0,0,0,8"/>
                        <DatePicker x:Name="DpInTransitLoadedDate" HorizontalAlignment="Stretch" Padding="8,6"/>
                    </StackPanel>
                </Border>

                <!-- 4. DELIVERED PANEL (Stage 3) -->
                <Border x:Name="PanelDelivered" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                        CornerRadius="8" Padding="18" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Çatdırılma Tarixi" FontWeight="SemiBold" FontSize="13" Foreground="#1B5E20" Margin="0,0,0,8"/>
                        <DatePicker x:Name="DpDeliveredDate" HorizontalAlignment="Stretch" Padding="8,6" Margin="0,0,0,14"/>

                        <TextBlock Text="Yola Çıxma Tarixi" FontWeight="SemiBold" FontSize="13" Foreground="#555" Margin="0,0,0,8"/>
                        <DatePicker x:Name="DpDeliveredTransitStart" HorizontalAlignment="Stretch" Padding="8,6" Margin="0,0,0,14"/>

                        <TextBlock Text="Yüklənmə Tarixi" FontWeight="SemiBold" FontSize="13" Foreground="#555" Margin="0,0,0,8"/>
                        <DatePicker x:Name="DpDeliveredLoadedDate" HorizontalAlignment="Stretch" Padding="8,6"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER BUTTONS -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="Ləğv et" Click="BtnCancel_Click"
                        Padding="20,10" Background="Transparent" Foreground="#666" BorderBrush="#D1D1D1" Margin="0,0,12,0"/>

                <Button Grid.Column="2" Click="BtnSave_Click"
                        Padding="26,10" Background="#005FB8" Foreground="White" BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtSaveButton" Text="Statusu Yenilə" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
