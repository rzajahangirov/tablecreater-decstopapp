<Window x:Class="TableCreater.WPF.Views.Dialogs.ExcelExportColumnsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Excel İxracı"
        Width="920" Height="760"
        MinHeight="600" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F8FAFC">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Stepper -->
            <RowDefinition Height="*"/>     <!-- Step Content -->
            <RowDefinition Height="Auto"/>  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER (Excel Green Brand) -->
        <Border Grid.Row="0" Background="#107C41" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="40" Height="40" Background="#1E8E4F" CornerRadius="8" Margin="0,0,14,0"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="Excel İxracı — Tranzaksiya Seçimi" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="TxtSubtitle" Text="" FontSize="12" Foreground="#D1FAE5" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. STEPPER INDICATOR -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="30,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Step 1 Indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border x:Name="Step1Circle" Width="30" Height="30" CornerRadius="15" 
                            Background="#107C41" Margin="0,0,10,0">
                        <TextBlock Text="1" FontSize="14" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="Step1Label" Text="Tranzaksiya Seçimi" FontSize="13" FontWeight="Bold" Foreground="#107C41"/>
                        <TextBlock Text="Hansı tranzaksiyaları ixrac etmək istəyirsiniz?" FontSize="10" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Connector Line -->
                <Border Grid.Column="1" Width="60" Height="2" Background="#E2E8F0" VerticalAlignment="Center" Margin="10,0"
                        x:Name="StepConnector"/>

                <!-- Step 2 Indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border x:Name="Step2Circle" Width="30" Height="30" CornerRadius="15" 
                            Background="#E2E8F0" Margin="0,0,10,0">
                        <TextBlock x:Name="Step2Number" Text="2" FontSize="14" FontWeight="Bold" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="Step2Label" Text="Sütun Seçimi" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8"/>
                        <TextBlock Text="Excel-ə hansı sütunları daxil etmək istəyirsiniz?" FontSize="10" Foreground="#CBD5E1"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. STEP CONTENT AREA -->
        <Grid Grid.Row="2">

            <!-- ════════════ STEP 1: Transaction Selection ════════════ -->
            <Grid x:Name="PanelStep1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Quick Actions -->
                    <RowDefinition Height="*"/>     <!-- DataGrid -->
                    <RowDefinition Height="Auto"/>  <!-- Summary -->
                </Grid.RowDefinitions>

                <!-- Quick Action Buttons -->
                <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="18,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Click="BtnSelectAllTx_Click"
                                Padding="10,5" Background="#F1F5F9" Foreground="#1E293B" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#107C41"/>
                                <TextBlock Text="Hamısını Seç" FontWeight="SemiBold" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Click="BtnSelectFilteredTx_Click"
                                Padding="10,5" Background="#F1F5F9" Foreground="#1E293B" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#005FB8"/>
                                <TextBlock x:Name="BtnFilteredText" Text="Filtrlənmişləri Seç" FontWeight="SemiBold" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Click="BtnDeselectAllTx_Click"
                                Padding="10,5" Background="#F1F5F9" Foreground="#1E293B" BorderThickness="0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#C62828"/>
                                <TextBlock Text="Seçimi Sıfırla" FontWeight="SemiBold" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <!-- Selected Count -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Seçilmiş: " FontSize="13" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtSelectedTxCount" Text="0" FontSize="14" FontWeight="Bold" Foreground="#107C41"/>
                            <TextBlock x:Name="TxtTotalTxCount" Text=" / 0" FontSize="13" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Transaction DataGrid with Checkboxes -->
                <DataGrid Grid.Row="1" x:Name="TxSelectionGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F0F0"
                          BorderThickness="0"
                          FontSize="12"
                          RowHeight="36"
                          ColumnHeaderHeight="34"
                          Background="Transparent"
                          HorizontalScrollBarVisibility="Auto"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          Margin="0">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F5F7FA"/>
                            <Setter Property="Foreground" Value="#555"/>
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="BorderBrush" Value="#E8E8E8"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Padding" Value="6,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- Checkbox Column -->
                        <DataGridTemplateColumn Header="✓" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelectedForExport, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Checked="TxCheckBox_Changed" Unchecked="TxCheckBox_Changed"
                                              Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Tarix -->
                        <DataGridTextColumn Header="Tarix" Binding="{Binding TransactionDate}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Məhsul -->
                        <DataGridTextColumn Header="Məhsul" Binding="{Binding ProductName}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#1E293B"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Göndərən -->
                        <DataGridTextColumn Header="Göndərən" Binding="{Binding SendingCompany}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Çəki -->
                        <DataGridTextColumn Header="Çəki(T)" Binding="{Binding WeightTonFormatted}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="#1E293B"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Xərc+Qazanc -->
                        <DataGridTextColumn Header="Xərc+Qazanc" Binding="{Binding BilledUsdFormatted}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#1A237E"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Ödəniş -->
                        <DataGridTextColumn Header="Ödəniş" Binding="{Binding PaidUsdFormatted}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Ödəniş Statusu -->
                        <DataGridTemplateColumn Header="Status" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFEBEE"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PaymentStatusDisplay}" Value="Ödənilib">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding PaymentStatusDisplay}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PaymentStatusDisplay}" Value="Ödənilib">
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Göndərmə Statusu -->
                        <DataGridTextColumn Header="Göndərmə" Binding="{Binding ShipmentStatusDisplay}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Summary Bar -->
                <Border Grid.Row="2" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="0,1,0,0" Padding="18,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                            <TextBlock Text="Seçilmiş Xərc+Qazanc: " FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSelectedBilled" Text="$0.00" FontSize="13" FontWeight="Bold" Foreground="#1A237E" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0">
                            <TextBlock Text="Seçilmiş Ödəniş: " FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSelectedPaid" Text="$0.00" FontSize="13" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="Seçilmiş Çəki: " FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSelectedWeight" Text="0 T" FontSize="13" FontWeight="Bold" Foreground="#E65100" VerticalAlignment="Center"/>
                        </StackPanel>

                        <CheckBox Grid.Column="4" x:Name="ChkAutoOpen" Content="İxracdan sonra faylı aç" IsChecked="True"
                                  FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ════════════ STEP 2: Column Selection ════════════ -->
            <Grid x:Name="PanelStep2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Actions Toolbar -->
                    <RowDefinition Height="*"/>     <!-- Category Cards -->
                </Grid.RowDefinitions>

                <!-- Actions Toolbar -->
                <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="18,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Click="BtnSelectAllCols_Click"
                                Padding="10,5" Background="#F1F5F9" Foreground="#1E293B" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#107C41"/>
                                <TextBlock Text="Hamısını Seç" FontWeight="SemiBold" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Click="BtnDeselectAllCols_Click"
                                Padding="10,5" Background="#F1F5F9" Foreground="#1E293B" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#C62828"/>
                                <TextBlock Text="Seçimi Təmizlə" FontWeight="SemiBold" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Click="BtnResetDefaultCols_Click"
                                Padding="10,5" Background="#F1F5F9" Foreground="#1E293B" BorderThickness="0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#D97706"/>
                                <TextBlock Text="Standart Sütunlar" FontWeight="SemiBold" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Seçilmiş sütunlar: " FontSize="13" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtSelectedColCount" Text="0 / 0" FontSize="14" FontWeight="Bold" Foreground="#107C41"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Scrollable Category Cards -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <StackPanel x:Name="PanelCategories">
                        <!-- Dynamically populated -->
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 4. FOOTER BUTTONS -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Error Text -->
                <TextBlock Grid.Column="0" x:Name="TxtError" Text="" Foreground="#C62828" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <!-- Cancel -->
                <Button Grid.Column="2" Content="İmtina" Click="BtnCancel_Click"
                        Padding="16,8" Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>

                <!-- Back (only visible on Step 2) -->
                <Button Grid.Column="3" x:Name="BtnBack" Click="BtnBack_Click" Visibility="Collapsed"
                        Padding="16,8" Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Geri" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                </Button>

                <!-- Next / Export -->
                <Button Grid.Column="4" x:Name="BtnNextExport" Click="BtnNextExport_Click"
                        Padding="20,8" Background="#107C41" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <StackPanel x:Name="BtnNextContent" Orientation="Horizontal">
                        <TextBlock x:Name="BtnNextText" Text="Davam Et — Sütun Seçimi" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
